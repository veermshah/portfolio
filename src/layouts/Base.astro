---
import '@fontsource/bricolage-grotesque/latin-400.css';
import '@fontsource/bricolage-grotesque/latin-500.css';
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '@fontsource/atkinson-hyperlegible-mono/latin-400.css';
import '../styles/global.css';
// Same file the 400 @font-face above points at, so the preload and the stylesheet share one hashed URL.
import bodyFont from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-400-normal.woff2?url';
// The hero name and the intro's board are set in 800, so it is fetched up front too.
import displayFont from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url';
import { profile } from '../data/profile';
import { BLOG_ORIGIN } from '../lib/blog/config';

interface Props {
  title: string;
  description: string;
  /** Path to an OG image under public/ or an absolute URL, defaults to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Pixel size of a non-default OG image, when known. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Absolute canonical URL; defaults to this path on the main site. */
  canonical?: string;
  ogType?: 'website' | 'article';
  /** ISO date for article:published_time (ogType article only). */
  publishedTime?: string;
  sitemap?: string;
  noindex?: boolean;
  /** Use the wide container (home page grids). */
  wide?: boolean;
}

const {
  title,
  description,
  ogImage = '/og.png',
  ogImageAlt = `${profile.name}, software engineer, with his portrait`,
  ogType = 'website',
  publishedTime,
  sitemap = '/sitemap-index.xml',
  noindex = false,
  wide = false,
} = Astro.props;
// The blog is the one place for writing, so its feed is the site's only feed.
const feeds = [{ title: `${profile.name}, blog`, href: `${BLOG_ORIGIN}/rss.xml` }];
// A noindex page with no explicit canonical (the 404 page) gets no canonical link rather than one to its own error path.
const canonical = Astro.props.canonical ?? (noindex ? undefined : new URL(Astro.url.pathname, Astro.site));
const ogUrl = new URL(ogImage, Astro.site);
const isSiteCard = ogImage.endsWith('/og.png');
const ogWidth = Astro.props.ogImageWidth ?? (isSiteCard ? 1200 : undefined);
const ogHeight = Astro.props.ogImageHeight ?? (isSiteCard ? 630 : undefined);
const year = new Date().getFullYear();
const navItems = [
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Education', href: '/#education' },
  { label: 'Photos', href: '/photography/', current: Astro.url.pathname.startsWith('/photography') },
  { label: 'Blog', href: 'https://blog.veermickey.com' },
  { label: 'Resume', href: '/resume.pdf' },
];
const footerSite = navItems.filter((item) => ['Work', 'Experience', 'Photos', 'Blog'].includes(item.label));
// One list of places to reach Veer, in one order, everywhere it appears.
const elsewhereOrder = ['Email', 'GitHub', 'LinkedIn', 'Devpost', 'Resume'];
const footerElsewhere = elsewhereOrder
  .map((label) => profile.links.find((link) => link.label === label))
  .filter((link): link is { label: string; href: string } => Boolean(link?.href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Light by day, dark from 7pm to 7am in the visitor's time zone, unless they picked one this visit.
      (() => {
        let theme;
        try { theme = sessionStorage.getItem('theme'); } catch {}
        const hour = new Date().getHours();
        document.documentElement.dataset.theme = theme || (hour >= 19 || hour < 7 ? 'dark' : 'light');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
        m.removeAttribute('media');
        m.content = document.documentElement.dataset.theme === 'dark' ? '#0a0a0a' : '#ffffff';
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href={sitemap} />
    {feeds.map((feed) => <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />)}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    {ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
    {ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content={new URL('/', Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/">{profile.name}</a>
        <nav class="site-nav" aria-label="Site">
          {navItems.map((item) => <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-resume" href="/resume.pdf">Resume</a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" hidden>
          Menu<span class="menu-lines" aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <dialog class="site-menu" id="site-menu" aria-label="Menu">
      <div class="site-menu-inner">
        <div class="site-menu-bar">
          <a class="wordmark" href="/">{profile.name}</a>
          <button class="menu-close" type="button">Close<span class="menu-lines" aria-hidden="true"></span></button>
        </div>
        <nav aria-label="Site">
          <ol class="site-menu-list">
            {navItems.map((item, i) => (
              <li style={`--i: ${i}`}>
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                  <span class="menu-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="menu-label">{item.label}</span>
                  <span class="menu-arrow" aria-hidden="true">{/^https?:|\.pdf$/.test(item.href) ? '↗' : '→'}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <div class="site-menu-foot">
          <button class="menu-switch" type="button" role="switch" aria-checked="false"><span class="menu-switch-track" aria-hidden="true"></span>Dark mode</button>
          <ul class="menu-pills" aria-label="Elsewhere">
            {footerElsewhere.filter((link) => link.label !== 'Resume').map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      </div>
    </dialog>
    <div class:list={['page', { 'is-wide': wide }]}>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-mark"><a href="/">{profile.name}</a></p>
          <nav class="footer-left" aria-label="Footer">
            <ul class="footer-col">
              {footerSite.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </nav>
          <ul class="footer-col footer-right" aria-label="Elsewhere">
            {footerElsewhere.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
          <p class="footer-meta"><span>© {year} {profile.name}</span><span class="footer-time" data-local-time>Dallas, Texas</span><a href="https://github.com/veermshah/portfolio">Site source</a></p>
        </div>
        <div class="footer-glow" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      </footer>
    </div>
    <script is:inline>
      // The blog subdomain serves only blog pages, so portfolio links in the header go to the main site.
      if (location.hostname === 'blog.veermickey.com') {
        for (const a of document.querySelectorAll('.site-header a[href^="/"], .site-menu a[href^="/"], .site-footer a[href^="/"]')) a.href = 'https://www.veermickey.com' + a.getAttribute('href');
      }
      const root = document.documentElement;
      const themeSwitch = document.querySelector('.menu-switch');
      const syncSwitch = () => themeSwitch?.setAttribute('aria-checked', String(root.dataset.theme === 'dark'));
      syncSwitch();
      const setTheme = () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { sessionStorage.setItem('theme', root.dataset.theme); } catch {}
        for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = root.dataset.theme === 'dark' ? '#0a0a0a' : '#ffffff';
        syncSwitch();
      };
      themeSwitch?.addEventListener('click', () => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return setTheme();
        if (!document.startViewTransition) {
          // No View Transitions: ease the colours instead.
          root.classList.add('theme-switching');
          setTimeout(() => root.classList.remove('theme-switching'), 450);
          return setTheme();
        }
        // The new theme grows as a circle out of the switch until it covers the screen.
        const r = themeSwitch.querySelector('.menu-switch-track')?.getBoundingClientRect() ?? themeSwitch.getBoundingClientRect();
        const x = r.left + r.width / 2, y = r.top + r.height / 2;
        const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.classList.add('theme-wipe');
        const t = document.startViewTransition(setTheme);
        t.ready.then(() => root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
          { duration: 700, easing: 'cubic-bezier(0.65, 0, 0.25, 1)', pseudoElement: '::view-transition-new(root)' },
        )).catch(() => {});
        t.finished.finally(() => root.classList.remove('theme-wipe'));
      });
      // Veer's local time in the footer, the same clock that turns the site dark at night.
      const clock = document.querySelector('[data-local-time]');
      if (clock) {
        const fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', hour: 'numeric', minute: '2-digit' });
        const tick = () => { clock.textContent = `Dallas ${fmt.format(new Date())}`; };
        tick();
        setInterval(tick, 30000);
      }
      // The menu is a modal dialog, so focus stays inside, Esc closes it and the page behind is inert.
      const menu = document.getElementById('site-menu');
      const menuButton = document.querySelector('.menu-button');
      if (menu && menuButton && typeof menu.showModal === 'function') {
        menuButton.hidden = false;
        const setOpen = (open) => menuButton.setAttribute('aria-expanded', String(open));
        menuButton.addEventListener('click', () => { menu.showModal(); setOpen(true); });
        menu.addEventListener('close', () => { setOpen(false); menuButton.focus(); });
        menu.querySelector('.menu-close').addEventListener('click', () => menu.close());
        menu.addEventListener('click', (e) => { if (e.target.closest('a')) menu.close(); });
      } else {
        // No dialog support: show the links in the bar instead.
        root.classList.remove('js');
      }

      // The bar gains a hairline once you scroll (and turns solid over the home hero).
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', scrollY > 24);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
    <script is:inline>
      // Links that leave the site (GitHub, LinkedIn, live demos, the resume PDF) open in a new tab.
      for (const a of document.querySelectorAll('a[href]:not([href^="#"])')) {
        const url = new URL(a.href, location.href);
        const offSite = /^https?:$/.test(url.protocol) && url.host !== location.host && !/(^|\.)veermickey\.com$/.test(url.hostname);
        const file = (url.host === location.host || /(^|\.)veermickey\.com$/.test(url.hostname)) && /\.pdf$|^\/demos\//.test(url.pathname);
        if (offSite || file) {
          a.target = '_blank';
          a.rel = (a.rel + ' noopener').trim();
        }
      }
    </script>
    <script>
      import "../scripts/track";
    </script>
  </body>
</html>
