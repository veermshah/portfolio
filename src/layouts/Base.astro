---
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/atkinson-hyperlegible-next/latin-800.css';
import '@fontsource/atkinson-hyperlegible-mono/latin-400.css';
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  /** Path to an OG image under public/, defaults to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Absolute canonical URL; defaults to this path on the main site. */
  canonical?: string;
  ogType?: 'website' | 'article';
  sitemap?: string;
  noindex?: boolean;
  /** Use the wide container (home page grids). */
  wide?: boolean;
}

const {
  title,
  description,
  ogImage = '/og.png',
  ogImageAlt = `${profile.name}, selected projects`,
  ogType = 'website',
  sitemap = '/sitemap-index.xml',
  noindex = false,
  wide = false,
} = Astro.props;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Light by day, dark from 7pm to 7am in the visitor's time zone, unless they picked one this visit.
      (() => {
        let theme;
        try { theme = sessionStorage.getItem('theme'); } catch {}
        const hour = new Date().getHours();
        document.documentElement.dataset.theme = theme || (hour >= 19 || hour < 7 ? 'dark' : 'light');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141517" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
        m.removeAttribute('media');
        m.content = document.documentElement.dataset.theme === 'dark' ? '#141517' : '#fcfcfc';
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href={sitemap} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {ogImage.endsWith('/og.png') && <meta property="og:image:width" content="1200" />}
    {ogImage.endsWith('/og.png') && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/">{profile.name}</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/#work">Work</a>
          <a class="nav-optional" href="/#experience">Experience</a>
          <a class="nav-optional" href="/#education">Education</a>
          <a href="/notes/" aria-current={Astro.url.pathname.startsWith('/notes') ? 'page' : undefined}>Notes</a>
          <a href="/photography/" aria-current={Astro.url.pathname.startsWith('/photography') ? 'page' : undefined}>Photos</a>
          <a href="https://blog.veermickey.com">Blog</a>
          <a href="/resume.pdf">Resume</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" hidden>
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>
    <div class:list={['page', { 'is-wide': wide }]}>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {year} {profile.name}</span>
        <a href="https://github.com/veermshah/portfolio">Site source</a>
      </footer>
    </div>
    <script is:inline>
      // The blog subdomain serves only blog pages, so portfolio links in the header go to the main site.
      if (location.hostname === 'blog.veermickey.com') {
        for (const a of document.querySelectorAll('.site-header a[href^="/"]')) a.href = 'https://www.veermickey.com' + a.getAttribute('href');
      }
      const toggle = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const syncToggle = () => toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      toggle.hidden = false;
      syncToggle();
      toggle.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { sessionStorage.setItem('theme', root.dataset.theme); } catch {}
        for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = root.dataset.theme === 'dark' ? '#141517' : '#fcfcfc';
        syncToggle();
      });
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const revealed = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -40px 0px' });
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('is-in'));
      }
    </script>
    <script is:inline>
      // Links that leave the site (GitHub, LinkedIn, live demos, the resume PDF) open in a new tab.
      for (const a of document.querySelectorAll('a[href]:not([href^="#"])')) {
        const url = new URL(a.href, location.href);
        const offSite = /^https?:$/.test(url.protocol) && url.host !== location.host && !/(^|\.)veermickey\.com$/.test(url.hostname);
        const file = (url.host === location.host || /(^|\.)veermickey\.com$/.test(url.hostname)) && /\.pdf$|^\/demos\//.test(url.pathname);
        if (offSite || file) {
          a.target = '_blank';
          a.rel = (a.rel + ' noopener').trim();
        }
      }
    </script>
    <script>
      import "../scripts/track";
    </script>
  </body>
</html>
