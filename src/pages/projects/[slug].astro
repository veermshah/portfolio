---
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { projects, type Project } from '../../data/projects';
import { roleSummary, myPart } from '../../lib/format';
import { categoriesByProject } from '../../data/project-categories';
import { breadcrumbs, jsonLd, metaDescription, personRef, projectTitle, schemaIds } from '../../lib/seo';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project: p, prev, next } = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*/*.{png,jpg,jpeg,webp}', {
  eager: true,
});

const images = p.images.map((img) => {
  const mod = assets[`../../assets/projects/${p.slug}/${img.file}`];
  if (!mod) throw new Error(`Missing image src/assets/projects/${p.slug}/${img.file}`);
  return { ...img, src: mod.default };
});

/** Render `inline code` spans in otherwise plain copy. */
const inline = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

const [lead, ...rest] = images;
const stripped = (s: string) => s.replace(/`/g, '');

// Related projects: up to three that share the most categories, then the nearest in list order.
// Previous and next are skipped because the pager already links them. Deterministic for a given list.
const here = projects.findIndex((x) => x.slug === p.slug);
const mine = categoriesByProject[p.slug] ?? [];
const related = projects
  .map((other, i) => ({ other, i, shared: (categoriesByProject[other.slug] ?? []).filter((c) => mine.includes(c)).length }))
  .filter(({ other, shared }) => shared > 0 && ![p.slug, prev?.slug, next?.slug].includes(other.slug))
  .sort((a, b) => b.shared - a.shared || Math.abs(a.i - here) - Math.abs(b.i - here) || a.i - b.i)
  .slice(0, 3)
  .map(({ other }) => other);

// SEO: a descriptive title, a 110 to 160 character description, the lead screenshot as the share card, and JSON-LD.
const pageTitle = projectTitle(p.slug, p.title, p.pitch);
const description = metaDescription([p.pitch, p.award && `${p.award}.`, p.problem]);
const og = lead
  ? await getImage({ src: lead.src, width: Math.min(1200, lead.src.width), format: 'jpg', quality: 80 })
  : undefined;
const pageUrl = new URL(`/projects/${p.slug}/`, Astro.site).href;
const ogImageUrl = new URL(og?.src ?? '/og.png', Astro.site).href;
const ids = schemaIds(Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': ids.website },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      mainEntity: { '@id': `${pageUrl}#project` },
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${pageUrl}#project`,
      name: p.title,
      description: stripped(p.pitch),
      url: pageUrl,
      ...(p.code && !p.codePrivate && p.code.startsWith('https://') ? { codeRepository: p.code } : {}),
      keywords: p.stack.join(', '),
      image: ogImageUrl,
      author: personRef(Astro.site),
      ...(p.award ? { award: p.award } : {}),
    },
    breadcrumbs(`${pageUrl}#breadcrumb`, [
      ['Home', ids.home],
      ['Projects', `${ids.home}#projects`],
      [p.title, pageUrl],
    ]),
  ],
};
---

<Base
  title={pageTitle}
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt={lead?.alt}
  ogImageWidth={og ? Number(og.attributes.width) : undefined}
  ogImageHeight={og ? Number(og.attributes.height) : undefined}
>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />
  <nav class="crumb"><a href="/#projects">← All projects</a></nav>

  <article data-track="article">
    <header class="head">
      <h1>{p.title}</h1>
      {p.award && <p class="award-line"><span class="award">{p.award}</span></p>}
      <p class="pitch" set:html={inline(p.pitch)} />
    </header>

    <dl class="facts">
      <div>
        <dt>Role</dt>
        <dd>{roleSummary(p)}{myPart(p) && `. My part: ${myPart(p)}.`}</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd><ul class="tags">{p.stack.map((t) => <li>{t}</li>)}</ul></dd>
      </div>
      <div>
        <dt>Links</dt>
        <dd>
          <ProjectLinks project={p} writeup={false} />
          {
            p.extra && (
              <p class="actions extra">
                {p.extra.filter((l) => l.label !== 'Devpost').map((l) => (
                  <a href={l.href}>{l.label}</a>
                ))}
              </p>
            )
          }
        </dd>
      </div>
    </dl>

    {
      lead && (
        <figure class="shot">
          <Image src={lead.src} alt={lead.alt} widths={[680, 1360]} sizes="(max-width: 720px) 100vw, 680px" format="webp" quality={78} loading="eager" fetchpriority="high" />
          {lead.caption && <figcaption>{lead.caption}</figcaption>}
        </figure>
      )
    }

    {
      p.video && (
        <figure class="shot">
          <video src={p.video.src} controls muted playsinline preload="metadata" aria-label={p.video.caption} />
          <figcaption>{p.video.caption}</figcaption>
        </figure>
      )
    }

    <section>
      <h2>Problem</h2>
      <p set:html={inline(p.problem)} />
    </section>

    <section>
      <h2>What I built</h2>
      {p.built.map((para) => <p set:html={inline(para)} />)}
    </section>

    <section>
      <h2>Results</h2>
      <ul class="results">{p.results.map((r) => <li set:html={inline(r)} />)}</ul>
    </section>

    {
      rest.map((img) => (
        <figure class="shot">
          <Image src={img.src} alt={img.alt} widths={[680, 1360]} sizes="(max-width: 720px) 100vw, 680px" format="webp" quality={78} />
          {img.caption && <figcaption>{img.caption}</figcaption>}
        </figure>
      ))
    }
  </article>

  {
    related.length > 0 && (
      <aside class="related" aria-label="Related reading">
        {related.length > 0 && (
          <>
            <h2 id="related-projects">Related projects</h2>
            <ul aria-labelledby="related-projects">
              {related.map((r) => (
                <li>
                  <a href={`/projects/${r.slug}/`}>{r.title}</a>
                  <p>{stripped(r.pitch)}</p>
                </li>
              ))}
            </ul>
          </>
        )}
      </aside>
    )
  }

  <nav class="pager" aria-label="More projects">
    {prev ? <a href={`/projects/${prev.slug}/`} rel="prev">Previous: {prev.title}</a> : <span />}
    {next ? <a href={`/projects/${next.slug}/`} rel="next">Next: {next.title}</a> : <a href="/">All projects</a>}
  </nav>
</Base>

<style>
  .crumb {
    font-size: 0.9375rem;
  }

  .head {
    margin-top: 2.5rem;
  }

  .head h1 {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .award-line {
    margin-top: 0.6rem;
  }

  .head .pitch {
    margin-top: 0.75rem;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .facts {
    margin: 2rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    color: var(--muted);
    font-size: 0.9375rem;
    padding-top: 0.05rem;
  }

  .facts dd {
    margin: 0;
    font-size: 0.9375rem;
    min-width: 0;
  }

  .facts .tags {
    padding-top: 0.15rem;
  }

  .extra {
    margin-top: 0.25rem;
  }

  @media (max-width: 30rem) {
    .facts > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  .shot {
    margin-top: 2.5rem;
  }

  .shot video {
    display: block;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: #0d1117;
  }

  .shot :global(img) {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: #fff;
  }

  .shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  section {
    margin-top: 2.75rem;
  }

  section h2 {
    font-size: 1.125rem;
    margin-bottom: 0.6rem;
  }

  section p + p {
    margin-top: 0.85rem;
  }

  .results {
    padding-left: 1.15rem;
  }

  .results li + li {
    margin-top: 0.5rem;
  }

  .related {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .related h2 {
    font-size: 1.125rem;
    margin-bottom: 0.6rem;
  }

  .related ul + h2 {
    margin-top: 2rem;
  }

  .related ul {
    list-style: none;
    padding: 0;
  }

  .related li + li {
    margin-top: 0.85rem;
  }

  .related li p {
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .pager {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: 0.9375rem;
  }
</style>
