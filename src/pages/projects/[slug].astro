---
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import GreaseLoop from '../../components/GreaseLoop.astro';
import { projects, type Project } from '../../data/projects';
import { roleSummary, myPart } from '../../lib/format';
import { categoriesByProject } from '../../data/project-categories';
import { breadcrumbs, jsonLd, metaDescription, personRef, projectTitle, schemaIds } from '../../lib/seo';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project: p, prev, next } = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*/*.{png,jpg,jpeg,webp}', {
  eager: true,
});

const images = p.images.map((img) => {
  const mod = assets[`../../assets/projects/${p.slug}/${img.file}`];
  if (!mod) throw new Error(`Missing image src/assets/projects/${p.slug}/${img.file}`);
  return { ...img, src: mod.default };
});

/** Render `inline code` spans in otherwise plain copy. */
const inline = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

const [lead, ...rest] = images;
const stripped = (s: string) => s.replace(/`/g, '');

/** The first image of any project, for the frames on the contact strip at the foot of the page. */
const frameOf = (project: Project) => {
  const first = project.images[0];
  return first ? assets[`../../assets/projects/${project.slug}/${first.file}`]?.default : undefined;
};
const prevFrame = prev && frameOf(prev);
const nextFrame = next && frameOf(next);

// The title is set as large as the column allows. Its longest word sets the ceiling, so a long
// single word (WhatDoesDaFoxSay) shrinks to fit a 360px phone instead of breaking mid-word.
const longestWord = Math.max(8, ...p.title.split(/\s+/).map((w) => w.length));

// Related projects: up to three that share the most categories, then the nearest in list order.
// Previous and next are skipped because the pager already links them. Deterministic for a given list.
const here = projects.findIndex((x) => x.slug === p.slug);
const mine = categoriesByProject[p.slug] ?? [];
const related = projects
  .map((other, i) => ({ other, i, shared: (categoriesByProject[other.slug] ?? []).filter((c) => mine.includes(c)).length }))
  .filter(({ other, shared }) => shared > 0 && ![p.slug, prev?.slug, next?.slug].includes(other.slug))
  .sort((a, b) => b.shared - a.shared || Math.abs(a.i - here) - Math.abs(b.i - here) || a.i - b.i)
  .slice(0, 3)
  .map(({ other }) => other);

// SEO: a descriptive title, a 110 to 160 character description, the lead screenshot as the share card, and JSON-LD.
const pageTitle = projectTitle(p.slug, p.title, p.pitch);
const description = metaDescription([p.pitch, p.award && `${p.award}.`, p.problem]);
const og = lead
  ? await getImage({ src: lead.src, width: Math.min(1200, lead.src.width), format: 'jpg', quality: 80 })
  : undefined;
const pageUrl = new URL(`/projects/${p.slug}/`, Astro.site).href;
const ogImageUrl = new URL(og?.src ?? '/og.png', Astro.site).href;
const ids = schemaIds(Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': ids.website },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      mainEntity: { '@id': `${pageUrl}#project` },
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${pageUrl}#project`,
      name: p.title,
      description: stripped(p.pitch),
      url: pageUrl,
      ...(p.code && !p.codePrivate && p.code.startsWith('https://') ? { codeRepository: p.code } : {}),
      keywords: p.stack.join(', '),
      image: ogImageUrl,
      author: personRef(Astro.site),
      ...(p.award ? { award: p.award } : {}),
    },
    breadcrumbs(`${pageUrl}#breadcrumb`, [
      ['Home', ids.home],
      ['Projects', `${ids.home}#projects`],
      [p.title, pageUrl],
    ]),
  ],
};
---

<Base
  title={pageTitle}
  description={description}
  ogImage={ogImageUrl}
  ogImageAlt={lead?.alt}
  ogImageWidth={og ? Number(og.attributes.width) : undefined}
  ogImageHeight={og ? Number(og.attributes.height) : undefined}
  wide
>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />
  <nav class="crumb" aria-label="Breadcrumb"><a href="/#projects">← All projects</a></nav>

  <article class="print" data-track="article">
    <header class="head" style={`--chars: ${longestWord}`}>
      <h1>{p.title}</h1>
      {
        p.award && (
          <p class="award-line">
            <span class="award-mark">
              {p.award}
              <GreaseLoop selected variant={1} />
            </span>
          </p>
        )
      }
      <div class="head-grid">
        <p class="pitch" set:html={inline(p.pitch)} />
        <dl class="facts">
          <div>
            <dt>Role</dt>
            <dd>{roleSummary(p)}{myPart(p) && `. My part: ${myPart(p)}.`}</dd>
          </div>
          <div>
            <dt>Stack</dt>
            <dd>{p.stack.join(', ')}</dd>
          </div>
        </dl>
      </div>
      <div class="links">
        <ProjectLinks project={p} writeup={false} />
        {
          p.extra && (
            <p class="actions extra">
              {p.extra.filter((l) => l.label !== 'Devpost').map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </p>
          )
        }
      </div>
    </header>

    {
      lead && (
        <figure class="plate lead">
          <Image
            src={lead.src}
            alt={lead.alt}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(max-width: 40rem) 100vw, (max-width: 80rem) 92vw, 74rem"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
          />
          {lead.caption && <figcaption>{lead.caption}</figcaption>}
        </figure>
      )
    }

    {
      p.video && (
        <figure class="plate lead">
          <video src={p.video.src} controls muted playsinline preload="metadata" aria-label={p.video.caption} />
          <figcaption>{p.video.caption}</figcaption>
        </figure>
      )
    }

    <div class="body">
      <section>
        <h2>Problem</h2>
        <div class="text">
          <p set:html={inline(p.problem)} />
        </div>
      </section>

      <section>
        <h2>What I built</h2>
        <div class="text">
          {p.built.map((para) => <p set:html={inline(para)} />)}
        </div>
      </section>

      <section>
        <h2>Results</h2>
        <div class="text">
          <ul class="results">{p.results.map((r) => <li set:html={inline(r)} />)}</ul>
        </div>
      </section>

      {
        rest.map((img) => (
          <figure class="plate">
            <Image
              src={img.src}
              alt={img.alt}
              widths={[640, 960, 1280, 1800]}
              sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 92vw, 58rem"
              format="webp"
              quality={78}
            />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <aside class="related" aria-label="Related reading">
        <h2 id="related-projects">Related projects</h2>
        <ul aria-labelledby="related-projects">
          {related.map((r) => (
            <li>
              <a href={`/projects/${r.slug}/`}>{r.title}</a>
              <p>{stripped(r.pitch)}</p>
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  <nav class="strip" aria-label="More projects">
    {
      prev ? (
        <a class="frame loop-host" href={`/projects/${prev.slug}/`} rel="prev">
          <span class="frame-pic">
            <span class="frame-img">
              {prevFrame && <Image src={prevFrame} alt="" widths={[240, 480]} sizes="(max-width: 40rem) 31vw, 15rem" format="webp" loading="lazy" />}
            </span>
            <GreaseLoop variant={0} />
          </span>
          <span class="frame-label">
            <span class="frame-dir">Previous<span class="visually-hidden">:</span></span> <span class="frame-title">{prev.title}</span>
          </span>
        </a>
      ) : (
        <span class="frame is-blank" aria-hidden="true">
          <span class="frame-pic"><span class="frame-img" /></span>
        </span>
      )
    }
    <span class="frame is-current" aria-hidden="true">
      <span class="frame-pic">
        <span class="frame-img">
          {lead && <Image src={lead.src} alt="" widths={[240, 480]} sizes="(max-width: 40rem) 31vw, 15rem" format="webp" loading="lazy" />}
        </span>
        <GreaseLoop selected variant={2} />
      </span>
      <span class="frame-label">
        <span class="frame-dir">This project</span> <span class="frame-title">{p.title}</span>
      </span>
    </span>
    {
      next ? (
        <a class="frame loop-host" href={`/projects/${next.slug}/`} rel="next">
          <span class="frame-pic">
            <span class="frame-img">
              {nextFrame && <Image src={nextFrame} alt="" widths={[240, 480]} sizes="(max-width: 40rem) 31vw, 15rem" format="webp" loading="lazy" />}
            </span>
            <GreaseLoop variant={1} />
          </span>
          <span class="frame-label">
            <span class="frame-dir">Next<span class="visually-hidden">:</span></span> <span class="frame-title">{next.title}</span>
          </span>
        </a>
      ) : (
        <a class="frame loop-host" href="/">
          <span class="frame-pic">
            <span class="frame-img frame-type"><span>All projects</span></span>
            <GreaseLoop variant={1} />
          </span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  /* A project page is a print made from one frame on the contact sheet: a big title block,
     the lead image large and in colour, then the write-up set for reading. */

  .crumb {
    font-size: var(--step--1);
  }

  .crumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* Title block */

  .head {
    margin-top: clamp(1.75rem, 1rem + 3vw, 3rem);
    container-type: inline-size;
  }

  .head h1 {
    /* Fluid, capped at the display max, and never wider than the column allows for the longest word. */
    font-size: min(clamp(2.5rem, 1.2rem + 5.5vw, 5.75rem), calc(100cqi / (var(--chars) * 0.64)));
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
    overflow-wrap: break-word;
    max-width: 16ch;
  }

  .award-line {
    margin-top: clamp(1.25rem, 0.9rem + 1vw, 1.75rem);
  }

  .award-mark {
    position: relative;
    display: inline-block;
    max-width: calc(100% + 0.9em);
    padding: 0.55em 0.9em;
    margin-left: -0.9em;
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .head-grid {
    margin-top: clamp(1.25rem, 0.8rem + 1.5vw, 2rem);
    display: grid;
    gap: 1.75rem;
  }

  .pitch {
    font-size: var(--step-2);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 34ch;
    text-wrap: pretty;
  }

  .facts {
    margin: 0;
    display: grid;
    gap: 1rem;
    align-content: start;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .facts dt {
    font-weight: 700;
  }

  .facts dd {
    margin: 0.1rem 0 0;
    color: var(--muted);
    min-width: 0;
    overflow-wrap: break-word;
  }

  @media (min-width: 52rem) {
    .head-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }

    .facts {
      padding-top: 0.45rem;
    }
  }

  /* Links: flat rectangles with a 1px border that invert on hover. The first one is filled. */

  .links {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .links :global(.actions) {
    display: contents;
  }

  .links :global(.actions a),
  .links :global(.actions .pending) {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .links :global(.actions a:hover) {
    background: var(--ink);
    color: var(--bg);
  }

  .links > :global(.actions:first-child > a:first-child) {
    background: var(--ink);
    color: var(--bg);
  }

  .links > :global(.actions:first-child > a:first-child:hover) {
    background: var(--bg);
    color: var(--ink);
  }

  .links :global(.actions .pending) {
    border-color: var(--rule);
    color: var(--muted);
    font-weight: 400;
  }

  /* Plates: the lead print runs the full width of the sheet; on a phone it runs edge to edge. */

  .plate {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .plate :global(img),
  .plate video {
    display: block;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .plate :global(img) {
    background: #fff;
  }

  .plate video {
    background: #0a0a0a;
  }

  .plate figcaption {
    margin-top: 0.6rem;
    max-width: 60ch;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--muted);
  }

  .plate + .plate {
    margin-top: 1rem;
  }

  @media (max-width: 40rem) {
    .lead {
      margin-inline: calc(-1 * var(--gutter));
    }

    .lead :global(img),
    .lead video {
      border-inline: 0;
      border-radius: 0;
    }

    .lead figcaption {
      padding-inline: var(--gutter);
    }
  }

  /* The write-up: a reading column of about 66 characters, headings in a left rail on wide screens. */

  .body {
    --rail: 13rem;
    --text: 40rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    max-width: calc(var(--rail) + var(--text) + 4rem);
  }

  .body section + section {
    margin-top: clamp(2.75rem, 2rem + 2vw, 3.75rem);
  }

  .body h2 {
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 0.85rem;
    text-wrap: balance;
  }

  .text {
    max-width: 66ch;
  }

  .text p {
    text-wrap: pretty;
  }

  .text p + p {
    margin-top: 1em;
  }

  .results {
    padding-left: 1.1em;
    list-style: square;
  }

  .results li {
    padding-left: 0.2em;
    text-wrap: pretty;
  }

  .results li::marker {
    color: var(--muted);
  }

  .results li + li {
    margin-top: 0.65em;
  }

  .body .plate {
    margin-top: clamp(2.75rem, 2rem + 2vw, 3.75rem);
  }

  @media (min-width: 60rem) {
    .body section {
      display: grid;
      grid-template-columns: var(--rail) minmax(0, var(--text));
      column-gap: 4rem;
      align-items: start;
    }

    .body h2 {
      margin-bottom: 0;
      padding-top: 0.05em;
      font-size: var(--step-1);
    }
  }

  /* Related projects */

  .related {
    margin-top: var(--space-section);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .related h2 {
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .related ul {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  .related a {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .related li p {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 44ch;
  }

  @media (min-width: 52rem) {
    .related ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* The contact strip: previous, this frame circled, next. Neighbours sit in greyscale until you
     reach for them, then print in colour and get circled. */

  .strip {
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 15rem));
    gap: 0.375rem;
  }

  .related + .strip {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .frame {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .frame-pic {
    position: relative;
    display: block;
  }

  .frame-img {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--accent-soft);
    border: 1px solid var(--rule);
  }

  .frame-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.45s var(--ease);
  }

  .frame:hover .frame-img :global(img),
  .frame:focus-visible .frame-img :global(img),
  .is-current .frame-img :global(img) {
    filter: none;
  }

  .is-blank .frame-img {
    background: transparent;
    border-style: dashed;
  }

  .frame-type {
    display: grid;
    place-items: center;
    padding: 0.5rem;
    text-align: center;
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .frame-label {
    display: block;
    margin-top: 0.65rem;
    padding-right: 0.25rem;
    line-height: 1.25;
  }

  .frame-dir {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .frame-title {
    display: block;
    margin-top: 0.1rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  a.frame:hover .frame-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .frame:focus-visible {
    outline-offset: 6px;
  }

  @media (max-width: 30rem) {
    .strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.25rem;
    }

    .frame-label {
      font-size: 0.875rem;
    }

    .frame-type {
      font-size: 0.9375rem;
    }
  }
</style>
