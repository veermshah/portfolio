---
import Base from '../../layouts/Base.astro';
import ContactButton from '../../components/ContactButton.astro';
import BackLink from '../../components/blog/BackLink.astro';
import { publishedPost, type Post } from '../../lib/blog/posts';
import { formatPostDate, readingMinutes, renderMarkdown, tagSlug } from '../../lib/blog/text';
import { BLOG_ORIGIN, blogBase } from '../../lib/blog/config';
import { CDN_CACHE, canonicalFor } from '../../lib/blog/http';
import '../../styles/blog.css';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const found = await publishedPost(slug);
Astro.response.headers.set('Cache-Control', CDN_CACHE);
const base = blogBase(Astro.url.hostname);
if (!found) {
  Astro.response.status = 404;
}
const post = found ?? ({ title: '', slug, excerpt: '', content: '', tags: [], cover_image_url: null, published_at: null, updated_at: '' } as unknown as Post);
const html = found ? renderMarkdown(post.content) : '';
const description = post.excerpt || `${post.title}, by Veer Mickey Shah.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  datePublished: post.published_at,
  dateModified: post.updated_at,
  author: { '@type': 'Person', '@id': new URL('/#person', Astro.site).href, name: 'Veer Mickey Shah', url: new URL('/', Astro.site).href },
  mainEntityOfPage: canonicalFor(`/${post.slug}`),
  ...(post.cover_image_url ? { image: post.cover_image_url } : {}),
  keywords: post.tags.join(', '),
};
---
{!found ? (
<Base title="Post not found | Veer Mickey Shah" description="This post doesn’t exist." canonical={canonicalFor(`/${slug}`)} sitemap="/sitemap.xml" noindex>
  <BackLink href={`${base}/`} label="All posts" />
  <h1 class="blog-title">Post not found</h1>
  <p class="blog-lede">There’s no published post at this address.</p>
</Base>
) : (
<Base
  title={`${post.title} | Veer Mickey Shah`}
  description={description}
  canonical={canonicalFor(`/${post.slug}`)}
  ogType="article"
  ogImage={post.cover_image_url ?? `${BLOG_ORIGIN}/og.png`}
  ogImageAlt={post.cover_image_url ? post.title : 'Veer Mickey Shah'}
  sitemap="/sitemap.xml"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.published_at} />
    <meta property="article:modified_time" content={post.updated_at} />
    {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <BackLink href={`${base}/`} label="All posts" />
  <article data-track="article">
    <header class="post-header">
      <p class="blog-meta"><time datetime={post.published_at}>{formatPostDate(post.published_at!)}</time> · {readingMinutes(post.content)} min read</p>
      <h1>{post.title}</h1>
      {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
      {post.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {post.tags.map((tag) => <li><a href={`${base}/tags/${tagSlug(tag)}`}>{tag}</a></li>)}
        </ul>
      )}
    </header>
    {post.cover_image_url && <img class="post-cover" src={post.cover_image_url} alt="" />}
    <div class="prose" set:html={html} />
  </article>
  <aside class="post-aside"><p>Have a question or a related idea?</p><ContactButton /></aside>
</Base>
)}
<style>
  .post-aside { margin-top: clamp(3rem, 2rem + 4vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--ink); }
  .post-aside p { margin-bottom: 1rem; font-size: var(--step-1); font-weight: 700; letter-spacing: -0.01em; }
</style>
