---
import Base from '../../layouts/Base.astro';
import ContactButton from '../../components/ContactButton.astro';
import { publishedPost } from '../../lib/blog/posts';
import { formatPostDate, readingMinutes, renderMarkdown, tagSlug } from '../../lib/blog/text';
import { BLOG_ORIGIN, blogBase } from '../../lib/blog/config';
import { CDN_CACHE, canonicalFor } from '../../lib/blog/http';
import '../../styles/blog.css';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const post = await publishedPost(slug);
if (!post) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', CDN_CACHE);

const base = blogBase(Astro.url.hostname);
const html = renderMarkdown(post.content);
const description = post.excerpt || `${post.title}, by Veer Shah.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  datePublished: post.published_at,
  dateModified: post.updated_at,
  author: { '@type': 'Person', name: 'Veer Shah', url: 'https://veermickey.com/' },
  mainEntityOfPage: canonicalFor(`/${post.slug}`),
  ...(post.cover_image_url ? { image: post.cover_image_url } : {}),
  keywords: post.tags.join(', '),
};
---
<Base
  title={`${post.title} | Veer Shah`}
  description={description}
  canonical={canonicalFor(`/${post.slug}`)}
  ogType="article"
  ogImage={post.cover_image_url ?? undefined}
  ogImageAlt={post.cover_image_url ? post.title : 'Veer Shah'}
  sitemap="/sitemap.xml"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.published_at} />
    <meta property="article:modified_time" content={post.updated_at} />
    {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="alternate" type="application/rss+xml" title="Veer Shah, blog" href={`${BLOG_ORIGIN}/rss.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <a class="blog-back" href={`${base}/`}>← All posts</a>
  <article>
    <header class="post-header">
      <p class="blog-meta"><time datetime={post.published_at}>{formatPostDate(post.published_at!)}</time> · {readingMinutes(post.content)} min read</p>
      <h1>{post.title}</h1>
      {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
      {post.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {post.tags.map((tag) => <li><a href={`${base}/tags/${tagSlug(tag)}`}>{tag}</a></li>)}
        </ul>
      )}
    </header>
    {post.cover_image_url && <img class="post-cover" src={post.cover_image_url} alt="" />}
    <div class="prose" set:html={html} />
  </article>
  <aside class="post-aside"><p>Have a question or a related idea?</p><ContactButton /></aside>
</Base>
<style>
  .post-aside { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .post-aside p { margin-bottom: 1rem; }
</style>
