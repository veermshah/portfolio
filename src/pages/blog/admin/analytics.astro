---
import AdminShell from '../../../components/blog/AdminShell.astro';
import '../../../styles/blog-analytics.css';
---
<AdminShell title="Engagement">
  <p data-gate class="admin-status">Checking sign-in…</p>
  <p data-signin hidden class="admin-status">Sign in on the <a data-admin-link href="../">blog admin</a> page first.</p>

  <section data-view="analytics" hidden>
    <div class="admin-bar">
      <h1 class="blog-title">Engagement</h1>
      <div class="actions"><a class="admin-button" data-admin-link href="../">Posts</a></div>
    </div>
    <form class="ana-filters" data-filters>
      <label>Range
        <select name="days"><option value="1">24 hours</option><option value="7" selected>7 days</option><option value="30">30 days</option><option value="90">90 days</option></select>
      </label>
      <label>Page <select name="page" data-pages><option value="">All pages</option></select></label>
      <label>Device
        <select name="device"><option value="desktop">Desktop</option><option value="mobile">Mobile</option><option value="tablet">Tablet</option></select>
      </label>
    </form>
    <p class="admin-status" data-status role="status"></p>

    <dl class="ana-stats" data-stats></dl>

    <div class="ana-grid">
      <section><h2>Pages</h2><table data-table="pages"></table></section>
      <section><h2>Sections (time on screen)</h2><table data-table="sections"></table></section>
      <section><h2>Clicks</h2><table data-table="clicks"></table></section>
      <section><h2>Outbound</h2><table data-table="outbound"></table></section>
      <section><h2>Referrers</h2><table data-table="referrers"></table></section>
      <section><h2>Devices</h2><table data-table="devices"></table></section>
    </div>

    <section class="ana-heat">
      <h2>Click heatmap <span class="admin-meta" data-heat-meta></span></h2>
      <p class="admin-meta">Shows your top page until you pick one above. Dots are clicks; the left bar shows how many sessions scrolled that far.</p>
      <div class="ana-frame" data-frame>
        <iframe data-iframe title="Page preview" tabindex="-1" scrolling="no"></iframe>
        <canvas data-canvas></canvas>
        <div class="ana-reach" data-reach></div>
      </div>
    </section>
  </section>
</AdminShell>

<script>
  import { initAnalytics } from '../../../scripts/blog/admin-analytics';
  initAnalytics();
</script>
