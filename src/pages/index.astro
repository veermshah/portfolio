---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { experience } from '../data/experience';
import { education, skills, knowsAbout } from '../data/education';
import LinkIcon from '../components/LinkIcon.astro';
import ContactButton from '../components/ContactButton.astro';
import Base from '../layouts/Base.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import Hero from '../components/Hero.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import { profile } from '../data/profile';
import { getImage } from 'astro:assets';
import portraitSrc from '../assets/portrait.jpg';
import { projects } from '../data/projects';
import { projectCategories, categoriesByProject } from '../data/project-categories';
import { jsonLd } from '../lib/seo';

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*/*.{png,jpg,jpeg,webp}', { eager: true });
/** The project's lead image and its alt text, or undefined when it has none. */
const thumb = (p: (typeof projects)[number]) => {
  const first = p.images[0];
  const src = first ? assets[`../assets/projects/${p.slug}/${first.file}`]?.default : undefined;
  return first && src ? { src, alt: first.alt } : undefined;
};
const categoryLabel: Record<string, string> = Object.fromEntries(projectCategories.map((c) => [c.id, c.label]));

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/experience/*.{jpg,png}', { eager: true });

for (const project of projects) {
  if (!categoriesByProject[project.slug]?.length) throw new Error(`Missing categories for ${project.slug}`);
}
const filters = [
  { id: 'all', label: 'All', count: projects.length },
  ...projectCategories.map((category) => ({
    ...category,
    count: projects.filter((project) => categoriesByProject[project.slug].includes(category.id)).length,
  })),
];

const featured = [
  { slug: 'proofsnap', label: 'Product', detail: 'Photo of a handwritten proof in, a Lean 4 check of every step out.' },
  { slug: 'veer', label: 'Compiler engineering', detail: 'Static contracts for KV-cache memory, token budgets and numeric error.' },
  { slug: 'dishbrain-playground', label: 'Experimental work', detail: 'Controlled experiments with paired seeds, ablations and held-out evaluation.' },
  { slug: 'wander', label: 'Accessibility', detail: 'Indoor navigation with a voice guide, 3D mapping and deterministic routing.' },
  { slug: 'destina' },
  { slug: 'quantumloans' },
].map((feature: { slug: string; label?: string; detail?: string }) => {
  const project = projects.find((project) => project.slug === feature.slug);
  if (!project) throw new Error(`Missing featured project: ${feature.slug}`);
  return { project, label: feature.label ?? project.award ?? '', detail: feature.detail ?? project.pitch };
});
const links = profile.links.filter((l) => l.href && l.label !== 'Email');

const siteUrl = new URL('/', Astro.site).href;
const portrait = await getImage({ src: portraitSrc, width: 640, format: 'jpg' });
const portraitUrl = new URL(portrait.src, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: profile.name,
      alternateName: [...profile.alternateNames, 'veermickey.com'],
      publisher: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: `${profile.name}, software engineer`,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: profile.name,
      givenName: 'Veer',
      familyName: 'Shah',
      alternateName: profile.alternateNames,
      url: siteUrl,
      jobTitle: 'Software Engineer',
      image: { '@type': 'ImageObject', url: portraitUrl, width: 640, height: 800, caption: `${profile.name} at his UT Dallas graduation` },
      description: profile.description,
      email: profile.links.find((l) => l.label === 'Email')?.href?.replace(/^mailto:/, ''),
      alumniOf: { '@id': `${siteUrl}#utd` },
      affiliation: [{ '@id': `${siteUrl}#hackutd` }, { '@id': `${siteUrl}#mlh` }, { '@id': `${siteUrl}#utd` }],
      memberOf: { '@id': `${siteUrl}#hackutd` },
      knowsAbout,
      homeLocation: {
        '@type': 'Place',
        address: { '@type': 'PostalAddress', addressLocality: profile.locality.city, addressRegion: profile.locality.region, addressCountry: profile.locality.country },
      },
      sameAs: profile.sameAs,
    },
    { '@type': 'CollegeOrUniversity', '@id': `${siteUrl}#utd`, name: 'University of Texas at Dallas', url: 'https://www.utdallas.edu' },
    { '@type': 'Organization', '@id': `${siteUrl}#hackutd`, name: 'HackUTD', url: 'https://hackutd.co' },
    { '@type': 'Organization', '@id': `${siteUrl}#mlh`, name: 'Major League Hacking', alternateName: 'MLH', url: 'https://mlh.io' },
  ],
};
---

<Base title={`${profile.name} (${profile.alternateNames[0]}), software engineer`} description={profile.description} wide>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />
  {profile.sameAs.map((href) => <link slot="head" rel="me" href={href} />)}
  <Hero>
    <div class="hero-layout">
      <div class="hero-portrait" data-reveal><HeroPortrait /></div>
      <div class="hero-text">
        <h1 id="hero-name" class="display" data-reveal style="--reveal-i: 1">{profile.name}</h1>
        <div class="name-slot" aria-hidden="true" hidden></div>
        <p class="bio" data-reveal style="--reveal-i: 2">{profile.bio}</p>
        <div class="hero-actions" data-reveal style="--reveal-i: 3">
          <ContactButton />
          <ul class="contact" aria-label="Elsewhere">
            {links.map((l) => <li><a class="icon-link" href={l.href} rel={profile.sameAs.includes(l.href!) ? 'me' : undefined}><LinkIcon name={l.label} />{l.label}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </Hero>

  <section id="work" class="section" aria-labelledby="featured-heading">
    <header class="section-head">
      <h2 id="featured-heading" class="section-title">Selected work</h2>
    </header>
    <ol class="selects" aria-label="Featured projects">
      {featured.map(({ project, label, detail }, i) => {
        const t = thumb(project);
        return (
          <li class="select">
            <div class="frame-media">
              {t ? (
                <Image src={t.src} alt={t.alt} widths={[480, 800, 1200]} sizes="(max-width: 40rem) 100vw, 36rem" format="webp" loading={i < 2 ? 'eager' : 'lazy'} />
              ) : (
                <span class="frame-blank" aria-hidden="true">{project.title}</span>
              )}
            </div>
            <div class="select-copy">
              <h3><a class="stretched" href={`/projects/${project.slug}/`}>{project.title}</a></h3>
              <p class="select-detail">{detail}</p>
              {label && <p class="select-label">{label}</p>}
              <ProjectLinks project={project} writeup={false} />
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <section id="projects" class="section" aria-labelledby="projects-heading">
    <header class="section-head">
      <h2 id="projects-heading" class="section-title">All projects <span class="count">{projects.length}</span></h2>
    </header>
    <div class="project-filter-controls" hidden>
      <div class="project-filters" role="group" aria-label="Filter projects by type">
        {filters.map((filter) => (
          <button type="button" data-project-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="project-list">
            {filter.label} <span class="filter-count">{filter.count}</span>
          </button>
        ))}
      </div>
      <p class="filter-status" role="status" aria-live="polite" aria-atomic="true">Showing all {projects.length} projects</p>
    </div>
    <ol class="sheet" id="project-list">
      {
        projects.map((p) => {
          const t = thumb(p);
          const types = categoriesByProject[p.slug].map((id) => categoryLabel[id]).join(', ');
          return (
            <li class="frame" data-categories={categoriesByProject[p.slug].join(' ')}>
              <div class="frame-media">
                {t ? (
                  <Image src={t.src} alt={t.alt} widths={[360, 720]} sizes="(max-width: 36rem) 100vw, (max-width: 56rem) 50vw, (max-width: 72rem) 33vw, 300px" format="webp" loading="lazy" />
                ) : (
                  <span class="frame-blank" aria-hidden="true">{p.title}</span>
                )}
              </div>
              <div class="frame-copy">
                <h3><a class="stretched" href={`/projects/${p.slug}/`}>{p.title}</a></h3>
                <p class="frame-meta">
                  {p.context && <span>{p.context}</span>}
                  <span>{types}</span>
                </p>
                {p.award && <p class="frame-award">{p.award}</p>}
                <p class="frame-pitch">{p.pitch}</p>
                <ProjectLinks project={p} />
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-heading">
    <header class="section-head">
      <h2 id="experience-heading" class="section-title">Experience</h2>
    </header>
    <ol class="experience">
      {experience.map((item) => (
        <li>
          <p class="when"><span>{item.period}</span><span>{item.location}</span></p>
          <div class="experience-main">
            <h3>
              {item.logo && logos[`../assets/experience/${item.logo}`] && (
                <span class="experience-logo">
                  <Image src={logos[`../assets/experience/${item.logo}`].default} alt="" width={52} height={52} format="webp" loading="lazy" />
                </span>
              )}
              {item.company}
            </h3>
            <p class="experience-role">{item.role}</p>
            <p class="experience-lead">{item.highlights[0]}</p>
            {item.highlights.length > 1 && (
              <details class="more">
                <summary><span class="more-closed">More</span><span class="more-open">Less</span></summary>
                <ul>{item.highlights.slice(1).map((line) => <li>{line}</li>)}</ul>
              </details>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="education" class="section" aria-labelledby="education-heading">
    <header class="section-head">
      <h2 id="education-heading" class="section-title">Education & skills</h2>
    </header>
    <div class="education-grid">
      <ol class="education">
        {education.map((item) => (
          <li>
            <p class="when"><span>{item.period}</span></p>
            <h3>{item.degree}</h3>
            <p class="education-school">{item.school}</p>
            <p class="education-detail">{item.detail}</p>
          </li>
        ))}
      </ol>
      <dl class="skills">
        {skills.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="contact-section" aria-labelledby="contact-heading">
    <div class="contact-inner">
      <h2 id="contact-heading">Let’s talk.</h2>
      <p>Questions about a project, an opportunity, or an idea to build together? Send me an email.</p>
      <div class="contact-actions">
        <ContactButton />
        <ul class="contact-links" aria-label="Elsewhere">
          {links.map((l) => <li><a class="icon-link" href={l.href}><LinkIcon name={l.label} />{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // Printed copies should include every experience highlight.
  let openedForPrint: HTMLDetailsElement[] = [];
  addEventListener('beforeprint', () => {
    openedForPrint = [...document.querySelectorAll<HTMLDetailsElement>('details.more:not([open])')];
    openedForPrint.forEach((d) => (d.open = true));
  });
  addEventListener('afterprint', () => {
    openedForPrint.forEach((d) => (d.open = false));
    openedForPrint = [];
  });

  const controls = document.querySelector<HTMLElement>('.project-filter-controls');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#project-list > .frame'));
  const status = document.querySelector<HTMLElement>('.filter-status');

  function selectFilter(requested: string | null) {
    const selected = buttons.find((button) => button.dataset.projectFilter === requested) ?? buttons[0];
    const filter = selected.dataset.projectFilter;
    for (const button of buttons) button.setAttribute('aria-pressed', String(button === selected));
    let visible = 0;
    for (const card of cards) {
      card.hidden = filter !== 'all' && !card.dataset.categories?.split(' ').includes(filter!);
      if (!card.hidden) visible++;
    }
    if (status) status.textContent = filter === 'all'
      ? `Showing all ${cards.length} projects`
      : `Showing ${visible} of ${cards.length} projects`;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.projectFilter!;
      selectFilter(filter);
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', filter);
      window.history.pushState(null, '', url);
    });
  }
  window.addEventListener('popstate', () => selectFilter(new URLSearchParams(window.location.search).get('type')));
  selectFilter(new URLSearchParams(window.location.search).get('type'));
  if (controls) controls.hidden = false;

</script>

<style>
  /* Hero (background and dots live in components/Hero.astro). The portrait is the big element:
     full width on phones with the name under it, a tall column beside the text on desktop. */
  .hero-layout { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero-portrait { width: 100%; }
  @media (min-width: 40rem) { .hero-portrait { width: min(100%, 24rem); } }
  @media (min-width: 64rem) {
    .hero-layout { grid-template-columns: minmax(0, 1fr) clamp(20rem, 30vw, 30rem); column-gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
    .hero-portrait { grid-column: 2; grid-row: 1; width: 100%; }
    .hero-text { grid-column: 1; grid-row: 1; }
    .hero-text .display, .hero-text .name-slot { margin-top: 0; }
  }
  /* Parallax, CSS only (see Hero.astro): the portrait rises a little faster than the page, and the
     big Selected work images slide gently inside their frames. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-portrait {
        animation: portrait-rise linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      @keyframes portrait-rise { to { transform: translate3d(0, -9vh, 0); } }
    }
  }
  @supports (animation-timeline: view()) and (overflow-clip-margin: content-box) {
    @media (prefers-reduced-motion: no-preference) {
      .select .frame-media { overflow: clip; overflow-clip-margin: content-box; }
      .select .frame-media :global(img) {
        animation: frame-slide linear both;
        animation-timeline: view();
        animation-range: cover;
      }
      @keyframes frame-slide {
        from { transform: translate3d(0, -4%, 0) scale(1.1); }
        to { transform: translate3d(0, 4%, 0) scale(1.1); }
      }
    }
  }
  /* .name-slot reserves the h1's space while the dot name is drawn there, so it shares the h1's type. */
  .display, .name-slot {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step-display);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .bio { margin-top: clamp(1.25rem, 2.5vw, 1.75rem); font-size: var(--step-1); line-height: 1.55; color: var(--muted); max-width: 38rem; text-wrap: pretty; }
  @media (max-width: 40rem) { .bio { font-size: 1.0625rem; line-height: 1.6; } }
  .hero-actions { margin-top: clamp(1.75rem, 3vw, 2.25rem); display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .contact { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-size: 0.9375rem; }
  .contact a { color: var(--muted); text-decoration: none; }
  .contact a:hover { color: var(--ink); }

  /* Hero over a photo: light text on the dark scrim in both themes. */
  :global(.hero) :is(.display, .bio, .contact) { text-shadow: 0 1px 14px rgb(0 0 0 / 0.35); }
  :global(.hero) .display { color: #fff; }
  :global(.hero) .bio { color: rgb(255 255 255 / 0.92); }
  :global(.hero) .contact a { color: rgb(255 255 255 / 0.88); }
  :global(.hero) .contact a:hover { color: #fff; }
  :global(.hero) a:focus-visible { outline-color: #fff; }
  :global(.hero .contact-button) { background: #fff; border-color: #fff; color: #0a0a0a; }
  :global(.hero .contact-button:hover) { background: transparent; color: #fff; }
  /* Comes last to win over the colours above. Until the dots take over, the h1 is transparent but still in the accessibility tree. */
  :global(.hero.dot-pending) .display { color: transparent; text-shadow: none; }

  /* Sections */
  .section { margin-top: var(--space-section); scroll-margin-top: 4.5rem; }
  .section-head { padding-top: 0.875rem; border-top: 2px solid var(--ink); margin-bottom: clamp(1.75rem, 4vw, 3rem); }
  .section-title { font-size: clamp(2.25rem, 1.35rem + 3.8vw, 4.5rem); font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; text-wrap: balance; }
  .section-title .count { font-size: var(--step-1); font-weight: 700; line-height: 1; letter-spacing: 0; color: var(--muted); font-variant-numeric: tabular-nums; vertical-align: top; margin-left: 0.1em; }
  .stretched::after { content: ''; position: absolute; inset: 0; z-index: 1; }

  /* Frames: a print on the contact sheet, set in a strip of film black. The rebate stays black in
     both themes, like the film itself. */
  .frame-media { position: relative; aspect-ratio: 3 / 2; padding: 3px; background: #0a0a0a; }
  .frame-media { aspect-ratio: auto; }
  .frame-media :global(img) { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; object-position: top center; }
  .frame-blank { display: flex; align-items: flex-end; aspect-ratio: 3 / 2; padding: 1rem; background: var(--accent-soft); color: var(--ink); font-size: var(--step-2); font-weight: 800; line-height: 1; letter-spacing: -0.03em; }

  /* Selected work: big frames. Size alone marks them as picks. */
  .selects { list-style: none; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4.5vw, 3.75rem); }
  @media (min-width: 40rem) { .selects { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .select { position: relative; display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
  .select-copy { display: grid; gap: 0.5rem; max-width: 34rem; }
  .select h3 { font-size: var(--step-3); font-weight: 800; line-height: 1; letter-spacing: -0.035em; }
  .select h3 a { text-decoration: none; }
  .select:hover h3 a { text-decoration-line: underline; text-decoration-thickness: 2px; text-decoration-color: currentColor; }
  .select-detail { color: var(--muted); text-wrap: pretty; }
  .select-label { font-size: var(--step--1); font-weight: 700; }
  .select :global(.actions) { position: relative; z-index: 3; gap: 0 1.1rem; font-size: 0.9375rem; }
  .select :global(.actions a), .select :global(.actions .pending) { display: inline-flex; align-items: center; min-height: 2.75rem; }

  /* All projects: the contact sheet, frames edge to edge in colour. */
  .project-filter-controls { margin-bottom: clamp(2rem, 4vw, 2.75rem); }
  .project-filters { display: flex; flex-wrap: wrap; gap: 0 0.25rem; margin-inline: -0.75rem; }
  .project-filters button { position: relative; min-height: 2.75rem; padding: 0.35rem 0.75rem; border: 0; background: none; font: inherit; color: var(--muted); cursor: pointer; }
  .project-filters button:hover, .project-filters button[aria-pressed='true'] { color: var(--ink); }
  .project-filters button[aria-pressed='true'] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.35em; }
  .filter-count { margin-left: 0.15em; font-size: var(--step--1); font-variant-numeric: tabular-nums; }
  .filter-status { margin-top: 0.5rem; color: var(--muted); font-size: var(--step--1); }

  .sheet { list-style: none; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 0; row-gap: clamp(2.25rem, 4vw, 3rem); }
  @media (min-width: 36rem) { .sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Phones: a dense two-up sheet of frames with title and type; the write-up, pitch and links are one tap away. */
  @media (max-width: 35.99rem) {
    .sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3px; row-gap: 1.5rem; }
    .frame-copy { padding: 0.6rem 0.25rem 0 3px; gap: 0.2rem; }
    .frame h3 { font-size: 1rem; }
    .frame-pitch { display: none; }
    /* Only the live site stays on the phone card; code, Devpost and the write-up are on the project page. */
    .frame :global(.actions > :not(.live-link)) { display: none; }
    .frame :global(.actions) { min-height: 0; }
    .frame :global(.actions .live-link) { min-height: 2.75rem; font-size: 0.8125rem; }
    .frame h3 a::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  }
  @media (min-width: 56rem) { .sheet { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .sheet { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .frame { position: relative; display: flex; flex-direction: column; min-width: 0; }
  .frame[hidden] { display: none; }
  .frame-copy { display: flex; flex-direction: column; gap: 0.35rem; padding: 0.9rem 1.25rem 0 3px; }
  .frame h3 { font-size: var(--step-1); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; }
  .frame h3 a { text-decoration: none; }
  .frame:hover h3 a { text-decoration-line: underline; text-decoration-thickness: 2px; text-decoration-color: currentColor; }
  .frame-meta { display: grid; font-size: var(--step--1); line-height: 1.45; color: var(--muted); }
  .frame-award { font-size: var(--step--1); font-weight: 700; line-height: 1.45; }
  .frame-pitch { margin-top: 0.2rem; font-size: 0.9375rem; color: var(--muted); text-wrap: pretty; }
  .frame :global(.actions) { position: relative; z-index: 3; gap: 0 1.1rem; font-size: 0.875rem; }
  .frame :global(.actions a), .frame :global(.actions .pending) { display: inline-flex; align-items: center; min-height: 2.75rem; }

  /* Experience */
  .experience { list-style: none; padding: 0; }
  .experience > li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; padding: clamp(1.75rem, 3vw, 2.5rem) 0; border-bottom: 1px solid var(--rule); }
  .experience > li:first-child { padding-top: 0; }
  .when { display: flex; flex-wrap: wrap; gap: 0 0.5rem; font-size: var(--step--1); color: var(--muted); font-variant-numeric: tabular-nums; }
  .when span + span::before { content: '·'; margin-right: 0.5rem; }
  @media (min-width: 48rem) {
    .experience > li { grid-template-columns: 13rem minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); }
    .experience .when { flex-direction: column; padding-top: 0.6rem; }
    .experience .when span + span::before { content: none; }
  }
