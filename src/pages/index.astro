---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { experience } from '../data/experience';
import { education, skills } from '../data/education';
import LinkIcon from '../components/LinkIcon.astro';
import ContactButton from '../components/ContactButton.astro';
import { notes, formatDate } from '../data/notes';
import Base from '../layouts/Base.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { projectCategories, categoriesByProject } from '../data/project-categories';
import { roleSummary, myPart } from '../lib/format';

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*/*.{png,jpg,jpeg,webp}', { eager: true });
const thumbnail = (p: (typeof projects)[number]) => {
  const first = p.images[0];
  return first ? assets[`../assets/projects/${p.slug}/${first.file}`]?.default : undefined;
};

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/experience/*.{jpg,png}', { eager: true });

for (const project of projects) {
  if (!categoriesByProject[project.slug]?.length) throw new Error(`Missing categories for ${project.slug}`);
}
const filters = [
  { id: 'all', label: 'All', count: projects.length },
  ...projectCategories.map((category) => ({
    ...category,
    count: projects.filter((project) => categoriesByProject[project.slug].includes(category.id)).length,
  })),
];

const featured = [
  { slug: 'veer', label: 'Compiler engineering', detail: 'Static contracts for KV-cache memory, token budgets and numeric error.' },
  { slug: 'dishbrain-playground', label: 'Experimental work', detail: 'Controlled experiments with paired seeds, ablations and held-out evaluation.' },
  { slug: 'wander', label: 'Accessibility', detail: 'Indoor navigation with a voice guide, 3D mapping and deterministic routing.' },
].map((feature) => {
  const project = projects.find((project) => project.slug === feature.slug);
  if (!project) throw new Error(`Missing featured project: ${feature.slug}`);
  return { ...feature, project };
});
const links = profile.links.filter((l) => l.href && l.label !== 'Email');
---

<Base title={`${profile.name}, software engineer`} description={profile.description} wide>
  <section class="hero" aria-labelledby="hero-name">
    <p class="kicker" data-reveal><span class="kicker-dot" aria-hidden="true"></span>Software engineer · M.S. CS, UT Dallas</p>
    <h1 id="hero-name" class="display" data-reveal style="--reveal-i: 1">{profile.name}</h1>
    <p class="bio" data-reveal style="--reveal-i: 2">{profile.bio}</p>
    <div class="hero-actions" data-reveal style="--reveal-i: 3">
      <ContactButton />
      <ul class="contact" aria-label="Elsewhere">
        {links.map((l) => <li><a class="icon-link" href={l.href}><LinkIcon name={l.label} />{l.label}</a></li>)}
      </ul>
    </div>
    <ul class="proof" aria-label="Experience at a glance" data-reveal style="--reveal-i: 4">
      {experience.map((item) => (
        <li>
          <span class="proof-logo"><Image src={logos[`../assets/experience/${item.logo}`].default} alt="" width={40} height={40} format="webp" /></span>
          <span><strong>{item.company.split(' · ')[0]}</strong><small>{item.role.split(' (')[0]}</small></span>
        </li>
      ))}
    </ul>
  </section>

  <section id="work" class="section" aria-labelledby="featured-heading">
    <header class="section-head" data-reveal>
      <p class="section-index">01</p>
      <h2 id="featured-heading" class="section-title">Featured work</h2>
    </header>
    <div class="featured-grid">
      {featured.map(({ project, label, detail }, i) => (
        <article class="featured-card" data-reveal style={`--reveal-i: ${i}`}>
          <a class="featured-media" href={`/projects/${project.slug}/`} tabindex="-1" aria-hidden="true">
            {thumbnail(project) && <Image src={thumbnail(project)!} alt="" widths={[400, 800, 1200]} sizes="(max-width: 48rem) 100vw, 33vw" format="webp" loading="lazy" />}
          </a>
          <div class="featured-copy">
            <p class="eyebrow">{label}</p>
            <h3><a class="stretched" href={`/projects/${project.slug}/`}>{project.title}</a></h3>
            <p>{detail}</p>
            <span class="featured-link" aria-hidden="true">Explore project <span class="arrow">→</span></span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-heading">
    <header class="section-head" data-reveal>
      <p class="section-index">02</p>
      <h2 id="experience-heading" class="section-title">Experience</h2>
    </header>
    <ol class="experience">
      {experience.map((item) => (
        <li data-reveal>
          <div class="experience-side">
            <div class="experience-logo">
              <Image src={logos[`../assets/experience/${item.logo}`].default} alt="" width={52} height={52} format="webp" loading="lazy" />
            </div>
            <p class="experience-meta">{item.period}<br />{item.location}</p>
          </div>
          <div class="experience-main">
            <h3>{item.company}</h3>
            <p class="experience-role">{item.role}</p>
            <ul>{item.highlights.map((line) => <li>{line}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="education" class="section" aria-labelledby="education-heading">
    <header class="section-head" data-reveal>
      <p class="section-index">03</p>
      <h2 id="education-heading" class="section-title">Education & skills</h2>
    </header>
    <div class="education-grid">
      <ol class="education">
        {education.map((item) => (
          <li data-reveal>
            <p class="experience-meta">{item.period}</p>
            <h3>{item.degree}</h3>
            <p class="experience-role">{item.school}</p>
            <p class="education-detail">{item.detail}</p>
          </li>
        ))}
      </ol>
      <dl class="skills" data-reveal>
        {skills.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <header class="section-head" data-reveal>
      <p class="section-index">04</p>
      <h2 id="projects-heading" class="section-title">All projects <span class="count">{projects.length}</span></h2>
    </header>
    <div class="project-filter-controls" hidden>
      <div class="project-filters" role="group" aria-label="Filter projects by type">
        {filters.map((filter) => (
          <button type="button" data-project-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="project-list">
            {filter.label} <span>{filter.count}</span>
          </button>
        ))}
      </div>
      <p class="filter-status" role="status" aria-live="polite" aria-atomic="true">Showing all {projects.length} projects</p>
    </div>
    <ol class="projects" id="project-list">
      {
        projects.map((p) => (
          <li class="project" data-categories={categoriesByProject[p.slug].join(' ')} data-reveal>
            <a class="thumbnail" href={`/projects/${p.slug}/`} tabindex="-1" aria-hidden="true">
              {thumbnail(p) ? (
                <Image src={thumbnail(p)!} alt="" widths={[360, 720]} sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 360px" format="webp" loading="lazy" />
              ) : (
                <span class="thumbnail-type"><span>{p.title}</span><small>{p.stack[0]}</small></span>
              )}
            </a>
            <div class="project-copy">
              <h3>
                <a href={`/projects/${p.slug}/`}>{p.title}</a>
                {p.award && <span class="award">{p.award}</span>}
              </h3>
              <p class="pitch">{p.pitch}</p>
              <p class="role">{roleSummary(p) + (myPart(p) ? `. My part: ${myPart(p)}.` : '')}</p>
              <ul class="tags" aria-label="Stack">
                {p.stack.map((t) => <li>{t}</li>)}
              </ul>
              <ProjectLinks project={p} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section recent-notes" aria-labelledby="notes-heading">
    <header class="section-head" data-reveal>
      <p class="section-index">05</p>
      <h2 id="notes-heading" class="section-title">Notes</h2>
    </header>
    <div class="notes-grid">
      {notes.slice(0, 2).map((note, i) => (
        <article data-reveal style={`--reveal-i: ${i}`}>
          <time datetime={note.frontmatter.date}>{formatDate(note.frontmatter.date)}</time>
          <h3><a class="stretched" href={`/notes/${note.slug}/`}>{note.frontmatter.title}</a></h3>
          <p>{note.frontmatter.description}</p>
        </article>
      ))}
    </div>
    <a class="all-notes" href="/notes/">All notes <span aria-hidden="true">→</span></a>
  </section>

  <section class="contact-section" aria-labelledby="contact-heading" data-reveal>
    <h2 id="contact-heading">Let’s talk.</h2>
    <p>Questions about a project, an opportunity, or an idea to build together? Send me an email.</p>
    <ContactButton />
  </section>
</Base>

<script>
  const controls = document.querySelector<HTMLElement>('.project-filter-controls');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#project-list > .project'));
  const status = document.querySelector<HTMLElement>('.filter-status');

  function selectFilter(requested: string | null) {
    const selected = buttons.find((button) => button.dataset.projectFilter === requested) ?? buttons[0];
    const filter = selected.dataset.projectFilter;
    for (const button of buttons) button.setAttribute('aria-pressed', String(button === selected));
    let visible = 0;
    for (const card of cards) {
      card.hidden = filter !== 'all' && !card.dataset.categories?.split(' ').includes(filter!);
      if (!card.hidden) visible++;
    }
    if (status) status.textContent = filter === 'all'
      ? `Showing all ${cards.length} projects`
      : `Showing ${visible} of ${cards.length} projects`;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.projectFilter!;
      selectFilter(filter);
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', filter);
      window.history.pushState(null, '', url);
    });
  }
  window.addEventListener('popstate', () => selectFilter(new URLSearchParams(window.location.search).get('type')));
  selectFilter(new URLSearchParams(window.location.search).get('type'));
  if (controls) controls.hidden = false;
</script>

<style>
  /* Hero */
  .hero { position: relative; padding-bottom: clamp(1rem, 3vw, 2rem); }
  .hero::before {
    content: '';
    position: absolute;
    inset: -12rem calc(-1 * var(--gutter)) -2rem;
    z-index: -1;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 13%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 35%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 30% 35%, #000 10%, transparent 75%);
    pointer-events: none;
  }
  .kicker { display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--step--1); letter-spacing: 0.01em; color: var(--muted); padding: 0.3rem 0.8rem 0.3rem 0.6rem; border: 1px solid var(--rule); border-radius: 999px; background: var(--bg); }
  .kicker-dot { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .display {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .bio { margin-top: clamp(1.25rem, 2.5vw, 1.75rem); font-size: var(--step-1); line-height: 1.55; color: var(--muted); max-width: 38rem; text-wrap: pretty; }
  .hero-actions { margin-top: clamp(1.75rem, 3vw, 2.25rem); display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .contact { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-size: 0.9375rem; }
  .contact a { color: var(--muted); text-decoration: none; }
  .contact a:hover { color: var(--ink); }
  .proof { list-style: none; padding: 0; margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.25rem; border-top: 1px solid var(--rule); }
  .proof li { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .proof-logo { flex: none; width: 2.5rem; height: 2.5rem; border-radius: 8px; overflow: hidden; border: 1px solid var(--rule); background: #fff; display: grid; place-items: center; }
  .proof-logo :global(img) { width: 2.1rem; height: 2.1rem; object-fit: contain; }
  .proof strong { display: block; font-size: 0.9375rem; line-height: 1.3; }
  .proof small { display: block; color: var(--muted); font-size: var(--step--1); line-height: 1.35; }
  @media (min-width: 64rem) { .proof { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .proof li { align-items: flex-start; } .proof-logo { width: 2rem; height: 2rem; } .proof-logo :global(img) { width: 1.7rem; height: 1.7rem; } }

  /* Sections */
  .section { margin-top: var(--space-section); scroll-margin-top: 4.5rem; }
  .section-head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .section-index { font-family: var(--mono); font-size: var(--step--1); color: var(--accent); }
  .section-title { font-size: var(--step-3); letter-spacing: -0.03em; }
  .section-title .count { font-family: var(--mono); font-size: var(--step--1); font-weight: 400; color: var(--muted); letter-spacing: 0; vertical-align: 0.6em; margin-left: 0.25rem; }
  .stretched::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }

  /* Featured */
  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .featured-card { position: relative; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; background: var(--bg); transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s var(--ease); }
  .featured-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: color-mix(in srgb, var(--ink) 18%, var(--rule)); }
  .featured-media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--accent-soft); border-bottom: 1px solid var(--rule); }
  .featured-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 0.6s var(--ease); }
  .featured-card:hover .featured-media :global(img) { transform: scale(1.03); }
  .featured-copy { padding: clamp(1rem, 2vw, 1.4rem); display: flex; flex-direction: column; flex: 1; gap: 0.6rem; }
  .eyebrow { color: var(--accent); font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .featured-card h3 { font-size: var(--step-2); letter-spacing: -0.02em; }
  .featured-card h3 a { text-decoration: none; }
  .featured-copy > p:not(.eyebrow) { font-size: 0.9375rem; color: var(--muted); }
  .featured-link { margin-top: auto; padding-top: 0.75rem; font-size: 0.875rem; font-weight: 700; }
  .featured-link .arrow { display: inline-block; transition: transform 0.3s var(--ease); }
  .featured-card:hover .featured-link { color: var(--accent); }
  .featured-card:hover .arrow { transform: translateX(4px); }
  .featured-card:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .featured-card a:focus-visible { outline: none; }
  @media (max-width: 52rem) { .featured-grid { grid-template-columns: 1fr; } .featured-media { aspect-ratio: 16 / 9; } }
  @media (min-width: 34rem) and (max-width: 52rem) { .featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .featured-card:last-child { grid-column: 1 / -1; } }

  /* Experience */
  .experience { list-style: none; padding: 0; }
  .experience > li { display: grid; grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr); gap: 1.5rem clamp(1.5rem, 4vw, 4rem); padding: clamp(1.5rem, 3vw, 2.25rem) 0; border-bottom: 1px solid var(--rule); }
  .experience > li:first-child { padding-top: 0.5rem; }
  .experience-side { display: flex; flex-direction: column; gap: 0.9rem; }
  .experience-logo { width: 3.25rem; height: 3.25rem; display: grid; place-items: center; overflow: hidden; border: 1px solid var(--rule); border-radius: 10px; background: #fff; }
  .experience-logo :global(img) { width: 2.75rem; height: 2.75rem; object-fit: contain; }
  .experience-meta { color: var(--muted); font-size: var(--step--1); font-family: var(--mono); line-height: 1.6; }
  .experience h3 { font-size: var(--step-2); letter-spacing: -0.02em; }
  .experience-role { margin-top: 0.3rem; color: var(--accent); font-size: 0.9375rem; }
  .experience-main ul { padding-left: 1.1rem; margin-top: 1rem; color: var(--muted); font-size: 0.9375rem; max-width: var(--measure); }
  .experience-main ul li + li { margin-top: 0.55rem; }
  .experience-main ul li::marker { color: color-mix(in srgb, var(--muted) 60%, transparent); }
  @media (max-width: 40rem) {
    .experience > li { grid-template-columns: 1fr; gap: 1rem; }
    .experience-side { flex-direction: row; align-items: center; gap: 0.9rem; }
  }

  /* Education */
  .education-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .education { list-style: none; padding: 0; }
  .education > li { padding: 0 0 1.5rem; }
  .education > li + li { padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .education h3 { font-size: var(--step-1); margin-top: 0.4rem; letter-spacing: -0.01em; }
  .education-detail { margin-top: 0.5rem; color: var(--muted); font-size: 0.9375rem; }
  .skills { margin: 0; border-top: 1px solid var(--rule); }
  .skills > div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule); font-size: 0.9375rem; }
  .skills dt { color: var(--muted); font-family: var(--mono); font-size: var(--step--1); padding-top: 0.1rem; }
  .skills dd { margin: 0; }
  @media (max-width: 52rem) { .education-grid { grid-template-columns: 1fr; } }
  @media (max-width: 30rem) { .skills > div { grid-template-columns: 1fr; gap: 0.2rem; } }

  /* Projects */
  .project-filter-controls { margin-bottom: clamp(1.5rem, 3vw, 2rem); }
  .project-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .project-filters button { font: inherit; font-size: 0.875rem; padding: 0.4rem 0.85rem; border: 1px solid var(--rule); border-radius: 999px; background: var(--bg); color: var(--muted); cursor: pointer; transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background 0.2s var(--ease); }
  .project-filters button span { margin-left: 0.3rem; font-family: var(--mono); font-size: 0.75rem; opacity: 0.8; }
  .project-filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .project-filters button:hover:not([aria-pressed='true']) { border-color: color-mix(in srgb, var(--ink) 35%, var(--rule)); color: var(--ink); }
  .project-filters button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .filter-status { margin-top: 0.75rem; color: var(--muted); font-size: 0.8125rem; }
  .projects { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: clamp(2rem, 3vw, 2.75rem) clamp(1rem, 2vw, 1.5rem); }
  .project { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .project[hidden] { display: none; }
  .thumbnail { display: block; overflow: hidden; aspect-ratio: 16 / 10; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--accent-soft); text-decoration: none; transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease); }
  .thumbnail :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 0.6s var(--ease); }
  .project:hover .thumbnail { box-shadow: var(--shadow); border-color: color-mix(in srgb, var(--ink) 18%, var(--rule)); }
  .project:hover .thumbnail :global(img) { transform: scale(1.03); }
  .thumbnail-type { display: flex; flex-direction: column; justify-content: flex-end; gap: 0.4rem; height: 100%; padding: 1.25rem; color: var(--accent); font-family: var(--mono); font-size: 1.05rem; background: linear-gradient(135deg, var(--accent-soft), color-mix(in srgb, var(--accent-soft) 40%, var(--bg))); }
  .thumbnail-type small { font-size: 0.75rem; color: var(--muted); }
  .project-copy { min-width: 0; }
  .project h3 { font-size: var(--step-1); letter-spacing: -0.015em; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.6rem; }
  .project h3 a { text-decoration: none; }
  .project h3 a:hover { color: var(--accent); }
  .project .award { white-space: normal; }
  .pitch { margin-top: 0.45rem; font-size: 0.9375rem; }
  .role { margin-top: 0.45rem; font-size: var(--step--1); color: var(--muted); }
  .tags { margin-top: 0.7rem; }
  .project :global(.actions) { margin-top: 0.7rem; font-size: 0.875rem; }

  /* Notes */
  .notes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .recent-notes article { position: relative; padding: clamp(1.25rem, 2.5vw, 1.75rem); border: 1px solid var(--rule); border-radius: var(--radius); transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s var(--ease); }
  .recent-notes article:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: color-mix(in srgb, var(--ink) 18%, var(--rule)); }
  .recent-notes article:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .recent-notes article a:focus-visible { outline: none; }
  .recent-notes time { color: var(--muted); font-family: var(--mono); font-size: var(--step--1); }
  .recent-notes h3 { margin: 0.6rem 0 0.6rem; font-size: var(--step-1); letter-spacing: -0.015em; }
  .recent-notes h3 a { text-decoration: none; }
  .recent-notes article p { color: var(--muted); font-size: 0.9375rem; }
