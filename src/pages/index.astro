---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { experience } from '../data/experience';
import Base from '../layouts/Base.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { projectCategories, categoriesByProject } from '../data/project-categories';
import { roleSummary, myPart } from '../lib/format';

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*/*.{png,jpg,jpeg,webp}', { eager: true });
const thumbnail = (p: (typeof projects)[number]) => {
  const first = p.images[0];
  return first ? assets[`../assets/projects/${p.slug}/${first.file}`]?.default : undefined;
};

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/experience/*.{jpg,png}', { eager: true });

for (const project of projects) {
  if (!categoriesByProject[project.slug]?.length) throw new Error(`Missing categories for ${project.slug}`);
}
const filters = [
  { id: 'all', label: 'All', count: projects.length },
  ...projectCategories.map((category) => ({
    ...category,
    count: projects.filter((project) => categoriesByProject[project.slug].includes(category.id)).length,
  })),
];

const links = profile.links.filter((l) => l.href);
---

<Base title={`${profile.name}, software engineer`} description={profile.description}>
  <header class="intro">
    <h1>{profile.name}</h1>
    <p class="bio">{profile.bio}</p>
    <ul class="contact">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </header>

  <nav class="section-nav" aria-label="On this page">
    <a href="#experience">Experience</a>
    <a href="#projects-heading">Projects <span>{projects.length}</span></a>
  </nav>

  <section id="experience" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="section-title">Experience</h2>
    <ol class="experience">
      {experience.map((item) => (
        <li>
          <div class="experience-heading">
            <div class="experience-logo">
              <Image src={logos[`../assets/experience/${item.logo}`].default} alt="" width={52} height={52} format="webp" loading="lazy" />
            </div>
            <div>
              <p class="experience-meta">{item.period} · {item.location}</p>
              <h3>{item.company}</h3>
              <p class="experience-role">{item.role}</p>
            </div>
          </div>
          <ul>{item.highlights.map((line) => <li>{line}</li>)}</ul>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="section-title">Projects</h2>
    <div class="project-filter-controls" hidden>
      <div class="project-filters" role="group" aria-label="Filter projects by type">
        {filters.map((filter) => (
          <button type="button" data-project-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="project-list">
            {filter.label} <span>{filter.count}</span>
          </button>
        ))}
      </div>
      <p class="filter-status" role="status" aria-live="polite" aria-atomic="true">Showing all {projects.length} projects</p>
    </div>
    <ol class="projects" id="project-list">
      {
        projects.map((p) => (
          <li class="project" data-categories={categoriesByProject[p.slug].join(' ')}>
            <a class="thumbnail" href={`/projects/${p.slug}/`} tabindex="-1" aria-hidden="true">
              {thumbnail(p) ? (
                <Image src={thumbnail(p)!} alt="" widths={[240, 480]} sizes="(max-width: 480px) 100vw, 160px" format="webp" loading="lazy" />
              ) : (
                <span class="thumbnail-type"><span>{p.title}</span><small>{p.stack[0]}</small></span>
              )}
            </a>
            <div class="project-copy">
              <h3>
                <a href={`/projects/${p.slug}/`}>{p.title}</a>
                {p.award && <span class="award">{p.award}</span>}
              </h3>
              <p class="pitch">{p.pitch}</p>
              <p class="role">{roleSummary(p) + (myPart(p) ? `. My part: ${myPart(p)}.` : '')}</p>
              <ul class="tags" aria-label="Stack">
                {p.stack.map((t) => <li>{t}</li>)}
              </ul>
              <ProjectLinks project={p} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  const controls = document.querySelector<HTMLElement>('.project-filter-controls');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#project-list > .project'));
  const status = document.querySelector<HTMLElement>('.filter-status');

  function selectFilter(requested: string | null) {
    const selected = buttons.find((button) => button.dataset.projectFilter === requested) ?? buttons[0];
    const filter = selected.dataset.projectFilter;
    for (const button of buttons) button.setAttribute('aria-pressed', String(button === selected));
    let visible = 0;
    for (const card of cards) {
      card.hidden = filter !== 'all' && !card.dataset.categories?.split(' ').includes(filter!);
      if (!card.hidden) visible++;
    }
    if (status) status.textContent = filter === 'all'
      ? `Showing all ${cards.length} projects`
      : `Showing ${visible} of ${cards.length} projects`;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.projectFilter!;
      selectFilter(filter);
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', filter);
      window.history.pushState(null, '', url);
    });
  }
  window.addEventListener('popstate', () => selectFilter(new URLSearchParams(window.location.search).get('type')));
  selectFilter(new URLSearchParams(window.location.search).get('type'));
  if (controls) controls.hidden = false;
</script>

<style>
  .project-filter-controls { margin-top: 1.25rem; }
  .project-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .project-filters button { font: inherit; font-size: 0.875rem; padding: 0.4rem 0.7rem; border: 1px solid var(--rule); border-radius: 5px; background: var(--bg); color: var(--muted); cursor: pointer; }
  .project-filters button span { margin-left: 0.3rem; font-family: var(--mono); font-size: 0.75rem; }
  .project-filters button[aria-pressed='true'] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .project-filters button:hover { border-color: var(--accent); color: var(--accent); }
  .project-filters button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .filter-status { margin-top: 0.75rem; color: var(--muted); font-size: 0.8125rem; }
  .project[hidden] { display: none; }

  .section-nav { display: flex; gap: 1.5rem; margin-top: 2rem; font-size: 0.9375rem; }
  .section-nav span { color: var(--muted); font-family: var(--mono); font-size: 0.8rem; }
  .experience { list-style: none; padding: 0; }
  .experience > li { padding: 1.6rem 0; border-bottom: 1px solid var(--rule); }
  .experience-heading { display: flex; align-items: center; gap: 1rem; }
  .experience-heading > div:last-child { min-width: 0; }
  .experience-logo { flex: 0 0 3.75rem; width: 3.75rem; height: 3.75rem; display: grid; place-items: center; overflow: hidden; border: 1px solid var(--rule); border-radius: 8px; background: #fff; }
  .experience-logo :global(img) { width: 3.25rem; height: 3.25rem; object-fit: contain; }
  .experience h3 { font-size: 1.125rem; margin-top: 0.3rem; }
  .experience-meta { color: var(--muted); font-size: 0.8125rem; }
  .experience-role { margin-top: 0.25rem; }
  .experience ul { padding-left: 1.15rem; margin-top: 0.65rem; color: var(--muted); font-size: 0.9375rem; }
  .experience ul li + li { margin-top: 0.4rem; }
  .thumbnail { display: block; overflow: hidden; aspect-ratio: 16 / 10; border: 1px solid var(--rule); border-radius: 5px; background: var(--accent-soft); text-decoration: none; }
  .thumbnail :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .thumbnail-type { display: flex; flex-direction: column; justify-content: center; gap: 0.5rem; height: 100%; padding: 1rem; color: var(--accent); font-family: var(--mono); font-size: 0.95rem; }
  .thumbnail-type small { font-size: 0.7rem; color: var(--muted); }
  .project-copy { min-width: 0; }
  .project .award { white-space: normal; }


  .intro h1 {
    font-size: clamp(2.25rem, 7vw, 3rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .bio {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--muted);
    max-width: 36rem;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .section-title {
    margin-top: 4.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--muted);
  }

  .projects {
    list-style: none;
    padding: 0;
  }

  .project {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .project h3 {
    font-size: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.65rem;
  }

  .project h3 a {
    text-decoration: none;
  }

  .project h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .pitch {
    margin-top: 0.4rem;
  }

  .role {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .tags {
    margin-top: 0.6rem;
  }

  .project :global(.actions) {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
  }
  @media (max-width: 30rem) {
    .project { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .thumbnail { max-width: 100%; }
  }
</style>
