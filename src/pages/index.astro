---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { experience } from '../data/experience';
import { education, skills } from '../data/education';
import LinkIcon from '../components/LinkIcon.astro';
import ContactButton from '../components/ContactButton.astro';
import { notes, formatDate } from '../data/notes';
import Base from '../layouts/Base.astro';
import dayPhoto from '../assets/photos/marina-bay.jpg';
import nightPhoto from '../assets/photos/skyline-night.jpg';
import ProjectLinks from '../components/ProjectLinks.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { projectCategories, categoriesByProject } from '../data/project-categories';

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*/*.{png,jpg,jpeg,webp}', { eager: true });
const thumbnail = (p: (typeof projects)[number]) => {
  const first = p.images[0];
  return first ? assets[`../assets/projects/${p.slug}/${first.file}`]?.default : undefined;
};

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/experience/*.{jpg,png}', { eager: true });

for (const project of projects) {
  if (!categoriesByProject[project.slug]?.length) throw new Error(`Missing categories for ${project.slug}`);
}
const filters = [
  { id: 'all', label: 'All', count: projects.length },
  ...projectCategories.map((category) => ({
    ...category,
    count: projects.filter((project) => categoriesByProject[project.slug].includes(category.id)).length,
  })),
];

const featured = [
  { slug: 'veer', label: 'Compiler engineering', detail: 'Static contracts for KV-cache memory, token budgets and numeric error.' },
  { slug: 'dishbrain-playground', label: 'Experimental work', detail: 'Controlled experiments with paired seeds, ablations and held-out evaluation.' },
  { slug: 'wander', label: 'Accessibility', detail: 'Indoor navigation with a voice guide, 3D mapping and deterministic routing.' },
  { slug: 'destina' },
  { slug: 'quantumloans' },
].map((feature: { slug: string; label?: string; detail?: string }) => {
  const project = projects.find((project) => project.slug === feature.slug);
  if (!project) throw new Error(`Missing featured project: ${feature.slug}`);
  return { project, label: feature.label ?? project.award ?? '', detail: feature.detail ?? project.pitch };
});
const links = profile.links.filter((l) => l.href && l.label !== 'Email');

const siteUrl = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: profile.name,
      alternateName: [...profile.alternateNames, 'veermickey.com'],
      publisher: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: `${profile.name}, software engineer`,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: profile.name,
      givenName: 'Veer',
      familyName: 'Shah',
      alternateName: profile.alternateNames,
      url: siteUrl,
      jobTitle: 'Software Engineer',
      description: profile.description,
      email: profile.links.find((l) => l.label === 'Email')?.href,
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Texas at Dallas', url: 'https://www.utdallas.edu' },
      memberOf: { '@type': 'Organization', name: 'HackUTD', url: 'https://hackutd.co' },
      sameAs: [...profile.links.filter((l) => l.href?.startsWith('https://')).map((l) => l.href), 'https://blog.veermickey.com'],
    },
  ],
};
---

<Base title={`${profile.name} (${profile.alternateNames[0]}), software engineer`} description={profile.description} wide>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <section class="hero" aria-labelledby="hero-name">
    <canvas class="hero-field" aria-hidden="true"></canvas>
    <p class="kicker" data-reveal><span class="pulse" aria-hidden="true"></span>Software engineer · M.S. CS, UT Dallas</p>
    <h1 id="hero-name" class="display" data-reveal style="--reveal-i: 1">{profile.name}</h1>
    <p class="bio" data-reveal style="--reveal-i: 2">{profile.bio}</p>
    <div class="hero-actions" data-reveal style="--reveal-i: 3">
      <ContactButton />
      <ul class="contact" aria-label="Elsewhere">
        {links.map((l) => <li><a class="icon-link" href={l.href}><LinkIcon name={l.label} />{l.label}</a></li>)}
      </ul>
    </div>
  </section>

  <section id="work" class="section" aria-labelledby="featured-heading">
    <header class="section-head carousel-head" data-reveal>
      <h2 id="featured-heading" class="section-title">Featured work</h2>
      <div class="carousel-controls">
        <span class="carousel-count" aria-hidden="true"><span data-current>1</span> / {featured.length}</span>
        <button class="carousel-btn" type="button" data-dir="-1" aria-label="Previous project" disabled>←</button>
        <button class="carousel-btn" type="button" data-dir="1" aria-label="Next project">→</button>
      </div>
    </header>
    <ol class="carousel" aria-label="Featured projects" data-reveal style="--reveal-i: 1">
      {featured.map(({ project, label, detail }, i) => (
        <li class="featured-card">
          <a class="featured-media" href={`/projects/${project.slug}/`} tabindex="-1" aria-hidden="true">
            {thumbnail(project) && <Image src={thumbnail(project)!} alt="" widths={[480, 800, 1200, 1600]} sizes="(max-width: 48rem) 86vw, 46rem" format="webp" loading={i < 2 ? 'eager' : 'lazy'} />}
          </a>
          <div class="featured-copy">
            {label && <p class="eyebrow">{label}</p>}
            <h3><a class="stretched" href={`/projects/${project.slug}/`}>{project.title}</a></h3>
            <p>{detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <figure class="photo" data-reveal>
    <Image class="photo-day" src={dayPhoto} alt="Marina Bay Sands and the ArtScience Museum under a cloudy sky" widths={[640, 1024, 1600, 2400]} sizes="100vw" format="webp" loading="lazy" />
    <Image class="photo-night" src={nightPhoto} alt="City skyline at night with illuminated buildings and a park" widths={[640, 1024, 1600, 2400]} sizes="100vw" format="webp" loading="lazy" />
    <figcaption>Photo by me · <a href="https://unsplash.com/@veermickey">more on Unsplash</a></figcaption>
  </figure>

  <section id="experience" class="section" aria-labelledby="experience-heading">
    <header class="section-head" data-reveal>
      <h2 id="experience-heading" class="section-title">Experience</h2>
    </header>
    <ol class="experience">
      {experience.map((item) => (
        <li data-reveal>
          <div class="experience-side">
            <div class="experience-logo">
              <Image src={logos[`../assets/experience/${item.logo}`].default} alt="" width={52} height={52} format="webp" loading="lazy" />
            </div>
            <p class="experience-meta">{item.period}<br />{item.location}</p>
          </div>
          <div class="experience-main">
            <h3>{item.company}</h3>
            <p class="experience-role">{item.role}</p>
            <p class="experience-lead">{item.highlights[0]}</p>
            {item.highlights.length > 1 && (
              <details class="more">
                <summary>More</summary>
                <ul>{item.highlights.slice(1).map((line) => <li>{line}</li>)}</ul>
              </details>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="education" class="section" aria-labelledby="education-heading">
    <header class="section-head" data-reveal>
      <h2 id="education-heading" class="section-title">Education & skills</h2>
    </header>
    <div class="education-grid">
      <ol class="education">
        {education.map((item) => (
          <li data-reveal>
            <p class="experience-meta">{item.period}</p>
            <h3>{item.degree}</h3>
            <p class="experience-role">{item.school}</p>
            <p class="education-detail">{item.detail}</p>
          </li>
        ))}
      </ol>
      <dl class="skills" data-reveal>
        {skills.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="projects" class="section" aria-labelledby="projects-heading">
    <header class="section-head" data-reveal>
      <h2 id="projects-heading" class="section-title">All projects <span class="count">{projects.length}</span></h2>
    </header>
    <div class="project-filter-controls" hidden>
      <div class="project-filters" role="group" aria-label="Filter projects by type">
        {filters.map((filter) => (
          <button type="button" data-project-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="project-list">
            {filter.label} <span>{filter.count}</span>
          </button>
        ))}
      </div>
      <p class="filter-status" role="status" aria-live="polite" aria-atomic="true">Showing all {projects.length} projects</p>
    </div>
    <ol class="projects" id="project-list">
      {
        projects.map((p) => (
          <li class="project" data-categories={categoriesByProject[p.slug].join(' ')} data-reveal>
            <a class="thumbnail" href={`/projects/${p.slug}/`} tabindex="-1" aria-hidden="true">
              {thumbnail(p) ? (
                <Image src={thumbnail(p)!} alt="" widths={[360, 720]} sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 360px" format="webp" loading="lazy" />
              ) : (
                <span class="thumbnail-type"><span>{p.title}</span><small>{p.stack[0]}</small></span>
              )}
            </a>
            <div class="project-copy">
              <h3>
                <a href={`/projects/${p.slug}/`}>{p.title}</a>
                {p.award && <span class="award">{p.award}</span>}
              </h3>
              <p class="pitch">{p.pitch}</p>
              <div class="project-foot">
                <ProjectLinks project={p} />
                <button class="peek-toggle" type="button" aria-expanded="false" aria-controls={`peek-${p.slug}`} aria-label={`Quick look: ${p.title}`}>Quick look</button>
              </div>
              <div class="peek" id={`peek-${p.slug}`} hidden>
                <p class="peek-problem">{p.problem}</p>
                {p.results.length > 0 && <ul class="peek-results">{p.results.slice(0, 3).map((r) => <li>{r}</li>)}</ul>}
                <ul class="tags">{p.stack.map((t) => <li>{t}</li>)}</ul>
                <a class="peek-more" href={`/projects/${p.slug}/`}>Full write-up <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section recent-notes" aria-labelledby="notes-heading">
    <header class="section-head" data-reveal>
      <h2 id="notes-heading" class="section-title">Notes</h2>
    </header>
    <div class="notes-grid">
      {notes.slice(0, 2).map((note, i) => (
        <article data-reveal style={`--reveal-i: ${i}`}>
          <time datetime={note.frontmatter.date}>{formatDate(note.frontmatter.date)}</time>
          <h3><a class="stretched" href={`/notes/${note.slug}/`}>{note.frontmatter.title}</a></h3>
          <p>{note.frontmatter.description}</p>
        </article>
      ))}
    </div>
    <a class="all-notes" href="/notes/">All notes <span aria-hidden="true">→</span></a>
  </section>

  <section class="contact-section" aria-labelledby="contact-heading" data-reveal>
    <h2 id="contact-heading">Let’s talk.</h2>
    <p>Questions about a project, an opportunity, or an idea to build together? Send me an email.</p>
    <ContactButton />
  </section>
</Base>

<script>
  import { initHeroField } from '../scripts/hero-field';

  for (const track of document.querySelectorAll<HTMLElement>('.carousel')) {
    const section = track.closest('section')!;
    const [prev, next] = section.querySelectorAll<HTMLButtonElement>('.carousel-btn');
    const current = section.querySelector('[data-current]')!;
    const items = [...track.children] as HTMLElement[];
    const start = () => track.getBoundingClientRect().left + parseFloat(getComputedStyle(track).paddingLeft);
    const index = () => {
      const s = start();
      let best = 0;
      items.forEach((el, i) => { if (Math.abs(el.getBoundingClientRect().left - s) < Math.abs(items[best].getBoundingClientRect().left - s)) best = i; });
      return best;
    };
    const pad = () => { track.style.scrollPaddingInline = getComputedStyle(track).paddingLeft; };
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const shown = () => (atEnd() ? items.length - 1 : index());
    const update = () => {
      const i = shown();
      current.textContent = String(i + 1);
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = atEnd();
    };
    const go = (dir: number) => {
      const i = Math.min(items.length - 1, Math.max(0, shown() + dir));
      track.scrollTo({ left: track.scrollLeft + items[i].getBoundingClientRect().left - start(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    addEventListener('resize', () => { pad(); update(); });
    pad();
    update();
  }

  // Project cards expand in place to show the problem, results and stack.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('.peek-toggle')) {
    toggle.addEventListener('click', () => {
      const card = toggle.closest<HTMLElement>('.project')!;
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Close' : 'Quick look';
      document.getElementById(toggle.getAttribute('aria-controls')!)!.hidden = !open;
      card.classList.toggle('is-open', open);
      const top = card.getBoundingClientRect().top;
      if (open && (top < 64 || top > innerHeight * 0.6)) card.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  }

  initHeroField();

  // Printed copies should include every experience highlight.
  let openedForPrint: HTMLDetailsElement[] = [];
  addEventListener('beforeprint', () => {
    openedForPrint = [...document.querySelectorAll<HTMLDetailsElement>('details.more:not([open])')];
    openedForPrint.forEach((d) => (d.open = true));
  });
  addEventListener('afterprint', () => {
    openedForPrint.forEach((d) => (d.open = false));
    openedForPrint = [];
  });

  const controls = document.querySelector<HTMLElement>('.project-filter-controls');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#project-list > .project'));
  const status = document.querySelector<HTMLElement>('.filter-status');

  function selectFilter(requested: string | null) {
    const selected = buttons.find((button) => button.dataset.projectFilter === requested) ?? buttons[0];
    const filter = selected.dataset.projectFilter;
    for (const button of buttons) button.setAttribute('aria-pressed', String(button === selected));
    let visible = 0;
    for (const card of cards) {
      card.hidden = filter !== 'all' && !card.dataset.categories?.split(' ').includes(filter!);
      if (!card.hidden) visible++;
    }
    if (status) status.textContent = filter === 'all'
      ? `Showing all ${cards.length} projects`
      : `Showing ${visible} of ${cards.length} projects`;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.projectFilter!;
      selectFilter(filter);
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', filter);
      window.history.pushState(null, '', url);
    });
  }
  window.addEventListener('popstate', () => selectFilter(new URLSearchParams(window.location.search).get('type')));
  selectFilter(new URLSearchParams(window.location.search).get('type'));
  if (controls) controls.hidden = false;
</script>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; padding-bottom: clamp(1rem, 3vw, 2rem); }
  .hero-field { position: absolute; z-index: -1; top: calc(-1 * clamp(3rem, 1.5rem + 6vw, 7rem)); left: calc(50% - 50vw); width: 100vw; height: calc(100% + clamp(3rem, 1.5rem + 6vw, 7rem) + 2rem); touch-action: pan-y; mask-image: linear-gradient(to bottom, #000 70%, transparent); -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent); }
  .kicker { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--mono); font-size: var(--step--1); color: var(--muted); padding: 0.3rem 0.75rem 0.3rem 0.6rem; border: 1px solid var(--rule); border-radius: 999px; background: color-mix(in srgb, var(--bg) 80%, transparent); }
  @media (max-width: 30rem) { .kicker { font-size: 0.75rem; letter-spacing: -0.02em; white-space: nowrap; } }
  .pulse { flex: none; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
  @media (prefers-reduced-motion: no-preference) { .pulse { animation: pulse 2.4s var(--ease) infinite; } }
  @keyframes pulse { 70% { box-shadow: 0 0 0 0.55rem transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .display {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step-display);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .display::after { content: '.'; color: var(--accent); }
  .bio { margin-top: clamp(1.25rem, 2.5vw, 1.75rem); font-size: var(--step-1); line-height: 1.55; color: var(--muted); max-width: 38rem; text-wrap: pretty; }
  .hero-actions { margin-top: clamp(1.75rem, 3vw, 2.25rem); display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .contact { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-size: 0.9375rem; }
  .contact a { color: var(--muted); text-decoration: none; }
  .contact a:hover { color: var(--ink); }

  /* Sections */
  .section { margin-top: var(--space-section); scroll-margin-top: 4.5rem; }
  .section-head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .section-title { font-size: var(--step-3); font-weight: 800; letter-spacing: -0.04em; }
  :global(main) { counter-reset: section; }
  .section-head { counter-increment: section; }
  .section-head .section-title::before { content: counter(section, decimal-leading-zero); display: block; margin-bottom: 0.4rem; font-family: var(--mono); font-size: var(--step--1); font-weight: 400; letter-spacing: 0; color: var(--accent); }
  .section-title .count { font-family: var(--mono); font-size: var(--step--1); font-weight: 400; color: var(--muted); letter-spacing: 0; vertical-align: 0.6em; margin-left: 0.25rem; }
  .stretched::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }

  /* Featured */
  .carousel-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .carousel-controls { display: flex; align-items: center; gap: 0.5rem; }
  .carousel-count { white-space: nowrap; font-family: var(--mono); font-size: var(--step--1); color: var(--muted); margin-right: 0.5rem; font-variant-numeric: tabular-nums; }
  .carousel-btn { width: 2.5rem; height: 2.5rem; border-radius: 999px; border: 1px solid var(--rule); background: var(--bg); color: var(--ink); font: inherit; cursor: pointer; transition: border-color 0.2s var(--ease), opacity 0.2s var(--ease); }
  .carousel-btn:hover:not(:disabled) { border-color: var(--ink); }
  .carousel-btn:disabled { opacity: 0.35; cursor: default; }
  .carousel { list-style: none; margin: 0 calc(50% - 50vw); padding: 0.25rem max(var(--gutter), calc(50vw - 50%)) 1rem; display: grid; grid-auto-flow: column; grid-auto-columns: min(86vw, 46rem); gap: clamp(0.875rem, 2vw, 1.5rem); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: max(var(--gutter), (100vw - var(--wide)) / 2); overscroll-behavior-x: contain; scrollbar-width: none; }
  .carousel::-webkit-scrollbar { display: none; }
  .carousel > li { scroll-snap-align: start; }
  .featured-card { position: relative; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; background: var(--bg); transition: border-color 0.25s var(--ease); }
  .featured-card:hover { border-color: color-mix(in srgb, var(--ink) 30%, var(--rule)); }
  .featured-media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--accent-soft); border-bottom: 1px solid var(--rule); }
  .featured-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 0.6s var(--ease); }
  .featured-card:hover .featured-media :global(img) { transform: scale(1.03); }
  .featured-copy { padding: clamp(1rem, 2vw, 1.4rem); display: flex; flex-direction: column; flex: 1; gap: 0.6rem; }
  .eyebrow { color: var(--muted); font-size: var(--step--1); }
  .featured-card h3 { font-size: var(--step-2); letter-spacing: -0.02em; }
  .featured-card h3 a { text-decoration: none; }
  .featured-copy > p:not(.eyebrow) { font-size: 0.9375rem; color: var(--muted); }
  .featured-card:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .featured-card a:focus-visible { outline: none; }

  /* Experience */
  .experience { list-style: none; padding: 0; }
  .experience > li { display: grid; grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr); gap: 1.5rem clamp(1.5rem, 4vw, 4rem); padding: clamp(1.5rem, 3vw, 2.25rem) 0; border-bottom: 1px solid var(--rule); }
  .experience > li:first-child { padding-top: 0.5rem; }
  .experience-side { display: flex; flex-direction: column; gap: 0.9rem; }
  .experience-logo { width: 3.25rem; height: 3.25rem; display: grid; place-items: center; overflow: hidden; border: 1px solid var(--rule); border-radius: 10px; background: #fff; }
  .experience-logo :global(img) { width: 2.75rem; height: 2.75rem; object-fit: contain; }
  .experience-meta { color: var(--muted); font-size: var(--step--1); font-family: var(--mono); line-height: 1.6; }
  .experience h3 { font-size: var(--step-2); letter-spacing: -0.02em; }
  .experience-role { margin-top: 0.3rem; color: var(--accent); font-size: 0.9375rem; }
  .experience-lead { margin-top: 0.9rem; color: var(--muted); font-size: 0.9375rem; max-width: var(--measure); }
  .more { margin-top: 0.6rem; }
  .more summary { cursor: pointer; font-size: var(--step--1); color: var(--muted); list-style: none; display: inline-flex; gap: 0.35rem; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::after { content: '+'; }
  .more[open] summary::after { content: '−'; }
  .more summary:hover { color: var(--ink); }
