---
import Base from '../../layouts/Base.astro';
import ContactButton from '../../components/ContactButton.astro';
import { notes, formatDate } from '../../data/notes';
import { breadcrumbs, jsonLd, personRef, schemaIds } from '../../lib/seo';
export const getStaticPaths = () => notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
const { note } = Astro.props;
const { Content, frontmatter } = note;

const pageUrl = new URL(`/notes/${note.slug}/`, Astro.site).href;
const ids = schemaIds(Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#article`,
      headline: frontmatter.title,
      description: frontmatter.description,
      datePublished: frontmatter.date,
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      inLanguage: 'en',
      image: new URL('/og.png', Astro.site).href,
      author: personRef(Astro.site),
      publisher: personRef(Astro.site),
      isPartOf: { '@id': ids.website },
    },
    breadcrumbs(`${pageUrl}#breadcrumb`, [
      ['Home', ids.home],
      ['Notes', new URL('/notes/', Astro.site).href],
      [frontmatter.title, pageUrl],
    ]),
  ],
};
---
<Base title={`${frontmatter.title} | Veer Shah`} description={frontmatter.description} ogType="article" publishedTime={frontmatter.date}>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />
  <a href="/notes/">← All notes</a>
  <article data-track="article">
    <header>
      <time datetime={frontmatter.date}>{formatDate(frontmatter.date)}</time>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
  <aside><p>Have a question or a related idea?</p><ContactButton /></aside>
</Base>
<style>
  article { margin-top: 2rem; }
  time { color: var(--muted); font-size: 0.875rem; }
  h1 { margin-top: 0.5rem; font-size: clamp(2rem, 6vw, 2.75rem); }
  header p { margin-top: 1rem; color: var(--muted); font-size: 1.125rem; }
  .prose { margin-top: 2.5rem; }
  .prose :global(p) { margin: 1rem 0; }
  .prose :global(h2) { margin: 2rem 0 0.75rem; font-size: 1.4rem; }
  .prose :global(a) { overflow-wrap: anywhere; }
  aside { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  aside p { margin-bottom: 1rem; }
</style>
