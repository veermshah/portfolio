---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import marinaBay from '../assets/photos/marina-bay.jpg';
import skylineNight from '../assets/photos/skyline-night.jpg';
import bridge from '../assets/photos/bridge.jpg';
import bokeh from '../assets/photos/bokeh.jpg';
import netSculpture from '../assets/photos/net-sculpture.jpg';
import { getUnsplashPhotos, sized, UTM } from '../lib/unsplash';
import { breadcrumbs, jsonLd, personRef, schemaIds } from '../lib/seo';

const unsplash = profile.links.find((l) => l.label === 'Unsplash')?.href ?? 'https://unsplash.com/@veermickey';

const photos = await Promise.all(
  [
    { src: marinaBay, alt: 'Marina Bay Sands and the ArtScience Museum under a cloudy sky' },
    { src: bokeh, alt: 'Trees in front of a glass tower, with sunlight breaking through the leaves' },
    { src: bridge, alt: 'People on a curved steel footbridge above a river, with a red tour boat passing below' },
    { src: netSculpture, alt: 'A suspended net sculpture lit magenta above a park at night' },
    { src: skylineNight, alt: 'City skyline at night with illuminated buildings and a park' },
  ].map(async (photo) => ({ ...photo, full: (await getImage({ src: photo.src, width: 2400, format: 'webp' })).src })),
);

// All photos come from Unsplash when UNSPLASH_ACCESS_KEY is set; the local five are the fallback.
const shots = await getUnsplashPhotos();
const profileUrl = `${unsplash}?${UTM}`;
const unsplashHome = `https://unsplash.com/?${UTM}`;

// The contact sheet lays frames out in justified rows: each frame's width is its aspect ratio times
// the row height, so every photo keeps its own shape. `sizes` estimates that width per frame from
// the row heights in the CSS below (about 136px on phones, 210px on tablets, 272px on desktop).
const sizesFor = (width: number, height: number) => {
  const ratio = width / height;
  const px = (row: number, cap: number) => Math.round(Math.min(ratio * row * 1.5, cap));
  return `(max-width: 30rem) ${px(136, 430)}px, (max-width: 64rem) ${px(210, 1000)}px, ${px(272, 1184)}px`;
};

// SEO: the top photo as the share card, and an ImageGallery with the photos as ImageObjects.
const pageUrl = new URL('/photography/', Astro.site).href;
const ids = schemaIds(Astro.site);
const title = `Photography by ${profile.name}`;
const description = `Photography by ${profile.name} (${profile.alternateNames[0]}), also published on Unsplash.`;
const top = shots[0];
const localCard = top ? undefined : await getImage({ src: photos[0].src, width: 1200, format: 'jpg', quality: 80 });
const og = top
  ? { src: `${top.raw}&w=1200&fm=jpg&fit=max&q=80`, width: 1200, height: Math.round((1200 * top.height) / top.width), alt: top.alt }
  : { src: new URL(localCard!.src, Astro.site).href, width: Number(localCard!.attributes.width), height: Number(localCard!.attributes.height), alt: photos[0].alt };
const images = top
  ? shots.slice(0, 30).map((photo) => ({
      '@type': 'ImageObject',
      contentUrl: sized(photo, 1200),
      url: photo.page,
      caption: photo.alt,
      width: photo.width,
      height: photo.height,
      creator: personRef(Astro.site),
      creditText: `${profile.name} on Unsplash`,
      license: 'https://unsplash.com/license',
      acquireLicensePage: photo.page,
    }))
  : photos.map((photo) => ({
      '@type': 'ImageObject',
      contentUrl: new URL(photo.full, Astro.site).href,
      caption: photo.alt,
      creator: personRef(Astro.site),
      creditText: profile.name,
    }));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ImageGallery',
      '@id': `${pageUrl}#gallery`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': ids.website },
      author: personRef(Astro.site),
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      associatedMedia: images,
    },
    breadcrumbs(`${pageUrl}#breadcrumb`, [
      ['Home', ids.home],
      ['Photography', pageUrl],
    ]),
  ],
};
---

<Base title={title} description={description} ogImage={og.src} ogImageAlt={og.alt} ogImageWidth={og.width} ogImageHeight={og.height} wide>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />
  <section id="photography" class="intro" aria-labelledby="photography-heading">
    <h1 id="photography-heading" class="display">Photography</h1>
    <a class="button unsplash" href={profileUrl}>
      Follow on Unsplash
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg>
    </a>
  </section>

  <section id="gallery" aria-label="Photos">
    {shots.length > 0 ? (
      <ul class="sheet" data-gallery>
        {shots.map((photo, i) => (
          <li class="frame" style={`--ratio: ${(photo.width / photo.height).toFixed(4)}; aspect-ratio: ${photo.width} / ${photo.height}; background: ${photo.color};`}>
            <a href={`${photo.page}?${UTM}`} data-full={sized(photo, 2000)} data-page={`${photo.page}?${UTM}`} aria-label={`View larger: ${photo.alt}`}>
              <img
                src={sized(photo, 600)}
                srcset={[400, 600, 900, 1200, 1600].map((w) => `${sized(photo, w)} ${w}w`).join(', ')}
                sizes={sizesFor(photo.width, photo.height)}
                width={photo.width}
                height={photo.height}
                alt={photo.alt}
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="sheet" data-gallery>
        {photos.map((photo, i) => (
          <li class="frame" style={`--ratio: ${(photo.src.width / photo.src.height).toFixed(4)}; aspect-ratio: ${photo.src.width} / ${photo.src.height};`}>
            <a href={photo.full} data-full={photo.full} aria-label={`Open full size: ${photo.alt}`}>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[480, 800, 1200, 1600, 2400]}
                sizes={sizesFor(photo.src.width, photo.src.height)}
                format="webp"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </a>
          </li>
        ))}
      </ul>
    )}
    {shots.length > 0 && <p class="credit">Photos by <a href={profileUrl}>Veer Mickey Shah</a> on <a href={unsplashHome}>Unsplash</a>.</p>}
  </section>

  <dialog class="viewer" data-viewer aria-label="Photo viewer">
    <img data-viewer-img alt="" />
    <p class="viewer-bar" aria-live="polite">
      <span data-viewer-alt></span>
      <a data-viewer-page href="#">View on Unsplash</a>
    </p>
    <button type="button" class="viewer-btn viewer-close" data-viewer-close aria-label="Close">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4.5 4.5l11 11M15.5 4.5l-11 11" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <button type="button" class="viewer-btn viewer-prev" data-viewer-step="-1" aria-label="Previous photo">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <button type="button" class="viewer-btn viewer-next" data-viewer-step="1" aria-label="Next photo">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M7.5 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
  </dialog>
</Base>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]');
  if (gallery && viewer && typeof viewer.showModal === 'function') {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-full]')];
    const img = viewer.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const alt = viewer.querySelector<HTMLElement>('[data-viewer-alt]')!;
    const page = viewer.querySelector<HTMLAnchorElement>('[data-viewer-page]')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      const thumb = link.querySelector('img')!;
      img.src = link.dataset.full!;
      img.alt = thumb.alt;
      alt.textContent = thumb.alt;
      // Local fallback photos have no Unsplash page to link to.
      page.hidden = !link.dataset.page;
      page.href = link.dataset.page ?? '#';
    };
    gallery.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-full]');
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      show(links.indexOf(link));
      viewer.showModal();
    });
    viewer.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-viewer-close]') || t === viewer) viewer.close();
      const step = t.closest<HTMLElement>('[data-viewer-step]');
      if (step) show(index + Number(step.dataset.viewerStep));
    });
    viewer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    viewer.addEventListener('close', () => links[index]?.focus());
    let startX = 0;
    viewer.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    viewer.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .display {
    /* "Photography." is about 6em wide at this tracking; the min() keeps it on one line down to 320px. */
    font-size: min(var(--step-display), calc((100vw - 2 * var(--gutter)) / 6.1));
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .unsplash svg { flex: none; transition: transform 0.2s var(--ease); }
  .unsplash:hover svg { transform: translateX(3px); }

  /* The contact sheet: frames in justified rows with one thin, even gutter. Each frame grows in
     proportion to its aspect ratio, so every frame in a row ends up the same height and no photo
     is cropped. The ::after filler keeps the last row from stretching. */
  .sheet {
    --row: clamp(8.5rem, 5rem + 14vw, 17rem);
    --gap: clamp(3px, 0.15rem + 0.25vw, 6px);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--gap);
  }
  .sheet::after { content: ''; flex: 999 1 0; }
  .frame {
    position: relative;
    flex: var(--ratio) 1 calc(var(--ratio) * var(--row));
    min-width: 0;
    background: var(--accent-soft);
    color: var(--ink);
  }
  .frame a { display: block; height: 100%; }
  .frame img, .frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .frame a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  /* A hairline of paper round the pencil keeps it readable over dark photos. */

  /* On phones the sheet runs to the edges of the screen. */
  @media (max-width: 40rem) {
    .sheet { margin-inline: calc(-1 * var(--gutter)); }
  }

  .credit { margin-top: 1.25rem; color: var(--muted); font-size: var(--step--1); }

  .viewer { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(10 10 10 / 0.96); color: #fff; }
  .viewer[open] { display: grid; grid-template-rows: 1fr auto; place-items: center; }
  .viewer::backdrop { background: rgb(0 0 0 / 0.6); }
  .viewer img { max-width: 100%; max-height: calc(100dvh - 5rem); object-fit: contain; padding: 3.75rem 0.75rem 0; }
  .viewer-bar { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: center; align-items: baseline; padding: 0.75rem 1rem 1.25rem; margin: 0; font-size: 0.875rem; text-align: center; }
  .viewer-bar span { color: rgb(255 255 255 / 0.75); }
  .viewer-bar span::first-letter { text-transform: uppercase; }
  .viewer-bar a { color: #fff; }
  .viewer-bar a[hidden] { display: none; }
  .viewer :focus-visible { outline-color: #fff; }
  .viewer-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 0;
    background: #0a0a0a;
    color: #fff;
    cursor: pointer;
    transition: background 0.15s var(--ease), color 0.15s var(--ease);
  }
  .viewer-btn:hover { background: #fff; color: #0a0a0a; border-color: #fff; }
  .viewer-close { top: 0.75rem; right: 0.75rem; }
  .viewer-prev, .viewer-next { top: 50%; transform: translateY(-50%); }
  .viewer-prev { left: 0.75rem; }
  .viewer-next { right: 0.75rem; }

  @media (prefers-reduced-motion: reduce) { .unsplash svg { transition: none; } }
</style>
