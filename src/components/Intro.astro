---
// First-visit intro for the home page, built from Veer's own flights (src/data/flights.json).
// A departure board on black: one huge airport code flips through every airport he has flown
// through, sweeping west to east around the world, while a marker jumps across a faint map of his
// routes and a counter runs up to his number of flights. It slows, lands on DFW (home), and the
// black splits open from the middle onto the page. Once per browser session, skipped with
// prefers-reduced-motion or without JavaScript, and any click or key ends it early. Text and inline
// SVG only, no images; the hero copy moves but never fades, so it does not delay the largest paint.
import flights from '../data/flights.json';
import { profile } from '../data/profile';

type Airport = { lat: number; lon: number; city: string; country: string };
const airports = flights.airports as Record<string, Airport>;
const LON0 = -130, LON1 = 150, LAT0 = 64, W = 1000;
const k = W / (LON1 - LON0);
const H = Math.round((LAT0 + 6) * k);
const at = (a: Airport) => [+((a.lon - LON0) * k).toFixed(1), +((LAT0 - a.lat) * k).toFixed(1)] as const;
const total = flights.routes.reduce((n, r) => n + r.count, 0);
const countries = new Set(Object.values(airports).map((a) => a.country)).size;
const arcs = flights.routes.map((r) => {
  const [x1, y1] = at(airports[r.a]);
  const [x2, y2] = at(airports[r.b]);
  const dx = x2 - x1, dy = y2 - y1, len = Math.hypot(dx, dy);
  const lift = Math.min(90, len * 0.22);
  let nx = -dy / len, ny = dx / len;
  if (ny > 0) { nx = -nx; ny = -ny; }
  const cx = (x1 + x2) / 2 + nx * lift, cy = (y1 + y2) / 2 + ny * lift;
  return `M${x1} ${y1}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2} ${y2}`;
});
// The board sweeps east from the Pacific and ends at home.
const stops = Object.entries(airports)
  .filter(([code]) => code !== 'DFW')
  .sort(([, a], [, b]) => a.lon - b.lon)
  .map(([code, a]) => ({ code, city: a.city, xy: at(a) }));
stops.push({ code: 'DFW', city: 'Dallas', xy: at(airports.DFW) });
const first = stops[0];
---

<script is:inline>
  (function () {
    var seen = false;
    try { seen = sessionStorage.getItem('intro') === '1'; } catch (e) {}
    if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('intro-on');
  })();
</script>
<div class="intro" aria-hidden="true" data-stops={JSON.stringify(stops)} data-total={total}>
  <div class="intro-top">
    <span>{profile.name}</span>
    <span><b class="intro-count">000</b> flights</span>
  </div>
  <div class="intro-board">
    <svg class="intro-map" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
      {arcs.map((d, i) => <path d={d} pathLength="1" style={`--i: ${i}`} />)}
      {stops.map((s) => <circle cx={s.xy[0]} cy={s.xy[1]} r="2.4" />)}
      <g class="intro-here" transform={`translate(${first.xy[0]} ${first.xy[1]})`}><circle r="7" /><circle r="2.8" /></g>
    </svg>
    <p class="intro-code">{[...first.code].map((c) => <span>{c}</span>)}</p>
    <p class="intro-city">{first.city}</p>
  </div>
  <div class="intro-bottom">
    <span>{stops.length} airports · {countries} countries</span>
    <span class="intro-home">Home · Dallas</span>
  </div>
</div>
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains('intro-on')) return;
    var intro = document.currentScript.previousElementSibling;
    var stops = JSON.parse(intro.dataset.stops);
    var total = Number(intro.dataset.total);
    var letters = intro.querySelectorAll('.intro-code span');
    var city = intro.querySelector('.intro-city');
    var count = intro.querySelector('.intro-count');
    var here = intro.querySelector('.intro-here');
    var done = false, timer = 0, i = 0, n = stops.length - 1;
    function flip(s) {
      for (var j = 0; j < 3; j++) {
        if (letters[j].textContent === s.code[j]) continue;
        letters[j].textContent = s.code[j];
        letters[j].animate([{ transform: 'translateY(0.1em)' }, { transform: 'none' }], { duration: 150, delay: j * 22, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', fill: 'backwards' });
      }
      city.textContent = s.city;
      here.setAttribute('transform', 'translate(' + s.xy[0] + ' ' + s.xy[1] + ')');
      count.textContent = String(Math.round(total * i / n)).padStart(3, '0');
    }
    function step() {
      if (done) return;
      i++;
      flip(stops[i]);
      if (i < n) {
        // Fast through the world, slowing as it comes home (about 1.6 s in all).
        timer = setTimeout(step, 25 + 120 * Math.pow(i / n, 3));
      } else {
        intro.classList.add('is-home');
        timer = setTimeout(open, 420);
      }
    }
    function open() {
      if (done) return;
      intro.classList.add('is-open');
      timer = setTimeout(finish, 800);
    }
    function finish() {
      if (done) return;
      done = true;
      clearTimeout(timer);
      try { sessionStorage.setItem('intro', '1'); } catch (e) {}
      root.classList.remove('intro-on');
      intro.remove();
    }
    timer = setTimeout(step, 260);
    addEventListener('pointerdown', finish, { once: true });
    addEventListener('keydown', finish, { once: true });
  })();
</script>

<style>
  .intro { display: none; }
  :global(html.intro-on) .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-bottom: clamp(1.25rem, 3vw, 2.25rem);
    color: var(--ink);
    pointer-events: none;
    /* Safety net: never cover the page for more than a few seconds, whatever happens to the script. */
    animation: intro-gone 0s linear 5s forwards;
  }
  @keyframes intro-gone { to { visibility: hidden; } }
  /* Two black halves, so the board can split open from the middle onto the page. */
  .intro::before, .intro::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    /* The board follows the theme the visitor is about to see, so there is no flash of the other one. */
    background: var(--bg);
    transition: transform 0.75s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .intro::before { top: 0; }
  .intro::after { bottom: 0; }
  .intro.is-open::before { transform: translateY(-100%); }
  .intro.is-open::after { transform: translateY(100%); }
  .intro > * { position: relative; z-index: 1; transition: opacity 0.25s ease; }
  .intro.is-open > * { opacity: 0; }

  .intro-top, .intro-bottom {
    width: 100%;
    max-width: calc(var(--wide) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  /* Same height and gutter as the site header, so the name stays put when the board opens. */
  .intro-top { height: var(--header-h); align-items: center; }
  .intro-top b { font-weight: 500; }
  .intro-bottom { color: var(--muted); }
  .intro-home { opacity: 0; transition: opacity 0.3s ease; }
  .intro.is-home .intro-home { opacity: 1; color: var(--ink); }

  .intro-board { position: relative; display: grid; place-items: center; align-content: center; min-height: 0; }
  .intro-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }
  .intro-map path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.8;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: route-draw 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-delay: calc(0.2s + var(--i) * 30ms);
  }
  @keyframes route-draw { to { stroke-dashoffset: 0; } }
  .intro-map circle { fill: var(--ink); }
  .intro-here circle:first-child { fill: none; stroke: var(--ink); stroke-width: 1.2; }
  /* Above the map, so the routes pass behind the letters. */
  .intro-code, .intro-city { position: relative; }
  .intro-code {
    display: flex;
    font-size: clamp(6rem, 30vw, 22rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  /* Fixed-width cells, so the code does not jitter as its letters change. */
  .intro-code span { display: inline-block; width: 0.68em; text-align: center; }
  .intro-city {
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  /* The hero settles in as the board opens, instead of under it. */
  :global(html.intro-on [data-reveal]) { animation-delay: calc(2.4s + var(--reveal-i, 0) * 90ms) !important; }
</style>
