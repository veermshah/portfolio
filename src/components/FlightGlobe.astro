---
// Flight globe section: the summary is plain HTML, the canvas is drawn by src/scripts/flight-globe.ts,
// which loads only when the section is about to scroll into view. Data: src/data/flights.json.
import flights from '../data/flights.json';

const airports = Object.values(flights.airports);
const flightCount = flights.routes.reduce((n, r) => n + r.count, 0);
const countries = new Set(airports.map((a) => a.country)).size;
const cities = [...new Set(airports.map((a) => a.city))].sort((a, b) => a.localeCompare(b));
---

<section id="flights" class="flights" aria-labelledby="flights-heading">
  <header class="section-head">
    <h2 id="flights-heading" class="section-title">Flights</h2>
  </header>
  <div class="flights-grid">
    <div class="flights-copy">
      <p class="flights-summary">{flightCount} flights between {airports.length} airports in {countries} countries and territories.</p>
      <p class="flights-cities">{cities.join(' · ')}</p>
    </div>
    <div class="flights-globe" data-flight-globe>
      <canvas aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<script>
  // The flight globe's code loads only when its section is about to scroll into view.
  const globe = document.querySelector<HTMLElement>('[data-flight-globe]');
  if (globe) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      import('../scripts/flight-globe').then(({ mountFlightGlobe }) => mountFlightGlobe(globe.querySelector('canvas')!));
    }, { rootMargin: '600px 0px' });
    io.observe(globe);
  }
</script>

<style>
  .flights { margin-top: var(--space-section); }
  .flights-grid { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .flights-summary { font-size: var(--step-1); line-height: 1.45; max-width: 30ch; text-wrap: pretty; }
  .flights-cities { margin-top: 1rem; font-family: var(--mono); font-size: var(--step--1); line-height: 1.7; color: var(--muted); max-width: 46ch; }
  .flights-globe { width: min(100%, 34rem); aspect-ratio: 1; justify-self: center; }
  .flights-globe canvas { display: block; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  .flights-globe canvas:active { cursor: grabbing; }
  @media (min-width: 48rem) { .flights-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } }
</style>
