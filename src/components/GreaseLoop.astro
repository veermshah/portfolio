---
// A loop drawn round a frame the way a photographer marks a select on a contact sheet with a
// grease pencil. Decorative only. Put it inside a positioned element; it draws itself when that
// element (or an ancestor with .loop-host) is hovered or focused, or always when `selected` is set.
interface Props {
  selected?: boolean;
  /** Picks one of a few hand-drawn variants so neighbouring loops don't look stamped. */
  variant?: number;
}
const { selected = false, variant = 0 } = Astro.props;
const paths = [
  'M18 64 C10 30 58 9 108 10 C160 11 194 31 190 62 C186 95 140 112 92 110 C44 108 12 92 16 62 C18 48 30 36 46 28',
  'M24 58 C20 24 72 8 118 12 C166 16 192 40 186 70 C180 100 128 114 80 108 C34 102 10 84 14 56 C17 40 34 26 58 20',
  'M14 70 C14 36 54 14 102 12 C152 10 192 28 192 60 C192 94 150 110 100 112 C52 114 16 98 12 68 C10 52 22 40 40 32',
];
const d = paths[Math.abs(variant) % paths.length];
---
<svg class:list={['grease-loop', { 'is-selected': selected }]} viewBox="0 0 200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path class="under" d={d} pathLength="1" />
  <path d={d} pathLength="1" />
</svg>

<style>
  .grease-loop {
    position: absolute;
    inset: -7% -5%;
    width: 110%;
    height: 114%;
    pointer-events: none;
    overflow: visible;
    z-index: 2;
  }
  .grease-loop path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }
  /* A wider stroke in the page colour under the pencil line keeps the loop readable on light and dark images. */
  .grease-loop path.under { stroke: var(--bg); stroke-width: 7px; }
  .grease-loop.is-selected path,
  :global(.loop-host:hover) .grease-loop path,
  :global(.loop-host:focus-within) .grease-loop path {
    stroke-dashoffset: 0;
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .grease-loop path { transition: stroke-dashoffset 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.1s linear; }
  }
</style>
