---
// Optional round portrait beside the home bio. Renders only when src/assets/portrait.jpg (or
// .jpeg, .png, .webp) exists; drop a square photo there to show it. Update the alt text below
// if you swap in a different photo.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;
---

{portrait && (
  <span class="portrait">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      fallbackFormat={portrait.format === 'png' ? 'png' : 'jpg'}
      widths={[80, 160, 240]}
      sizes="5rem"
      width={160}
      height={160}
      alt="Veer Shah at his UT Dallas graduation"
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
  </span>
)}

<style>
  .portrait { flex: none; display: block; }
  .portrait :global(img) {
    width: clamp(3.75rem, 2.9rem + 2.4vw, 5rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, currentColor 80%, transparent);
    box-shadow: 0 6px 20px -8px rgb(0 0 0 / 0.5);
  }
</style>
