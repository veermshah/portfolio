---
// Optional round portrait above the name in the home hero. Renders only when src/assets/portrait.jpg (or
// .jpeg, .png, .webp) exists; drop a square photo there to show it. Update the alt text below
// if you swap in a different photo.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;
---

{portrait && (
  <span class="portrait">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      fallbackFormat={portrait.format === 'png' ? 'png' : 'jpg'}
      widths={[112, 224, 336]}
      sizes="(min-width: 40rem) 7rem, 5.5rem"
      width={224}
      height={224}
      alt="Veer Shah at his UT Dallas graduation"
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
  </span>
)}

<style>
  .portrait { flex: none; display: block; }
  .portrait :global(img) {
    width: 5.5rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    /* A thin white ring and a soft shadow keep the photo distinct on any background photo. */
    box-shadow: 0 0 0 2px #fff, 0 14px 34px -12px rgb(0 0 0 / 0.7);
  }
  @media (min-width: 40rem) {
    .portrait :global(img) { width: 7rem; }
  }
</style>
