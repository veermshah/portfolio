---
// Optional portrait above the name in the home hero, head and shoulders at 4:5. Renders only when src/assets/portrait.jpg (or
// .jpeg, .png, .webp) exists; drop a 4:5 photo there to show it. Update the alt text below
// if you swap in a different photo.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;
---

{portrait && (
  <span class="portrait">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      fallbackFormat={portrait.format === 'png' ? 'png' : 'jpg'}
      widths={[380, 570, 760]}
      sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 24rem, calc(100vw - 2.5rem)"
      width={760}
      height={950}
      alt="Veer Shah at his UT Dallas graduation"
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
  </span>
)}

<style>
  .portrait { display: block; }
  /* Big and plain: no frame or ring, just the photo with a deep shadow so it sits on the
     background photo instead of looking pasted on. */
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.85);
  }
</style>
