---
// Optional portrait above the name in the home hero, head and shoulders at 4:5. Renders only when src/assets/portrait.jpg (or
// .jpeg, .png, .webp) exists; drop a 4:5 photo there to show it. Update the alt text below
// if you swap in a different photo.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;
---

{portrait && (
  <span class="portrait">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      fallbackFormat={portrait.format === 'png' ? 'png' : 'jpg'}
      widths={[160, 320, 480]}
      sizes="(min-width: 40rem) 10rem, 7.5rem"
      width={320}
      height={400}
      alt="Veer Shah at his UT Dallas graduation"
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
  </span>
)}

<style>
  .portrait { flex: none; display: block; }
  .portrait :global(img) {
    width: 7.5rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    /* A thin white edge and a soft shadow keep the photo distinct on any background photo. */
    box-shadow: 0 0 0 2px #fff, 0 18px 40px -14px rgb(0 0 0 / 0.75);
  }
  @media (min-width: 40rem) {
    .portrait :global(img) { width: 10rem; }
  }
</style>
