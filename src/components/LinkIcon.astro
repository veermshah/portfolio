---
interface Props { name: string; }
const { name } = Astro.props;
const kind = name.toLowerCase();
---
<svg class="link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {['github', 'code'].includes(kind) ? (
    <>
      <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.9c0-1.1-.1-1.7-.6-2.2 3.3-.4 6.8-1.6 6.8-7.3A5.7 5.7 0 0 0 19.7 4c.2-1 .2-2-.2-3 0 0-1.2-.4-3.9 1.5a13.4 13.4 0 0 0-7.2 0C5.7.6 4.5 1 4.5 1c-.4 1-.4 2-.2 3A5.7 5.7 0 0 0 2.8 8c0 5.8 3.5 7 6.8 7.4-.5.5-.7 1.3-.6 2.2V22" />
    </>
  ) : kind === 'linkedin' ? (
    <>
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <path d="M7.5 10v7M11 17v-7h3v1c1-2 4-1.5 4 1v5M7.5 7h.01" />
    </>
  ) : kind === 'unsplash' ? (
    <path stroke="none" fill="currentColor" d="M8 1h8v6H8V1ZM1 10h7v7h8v-7h7v13H1V10Z" />
  ) : kind === 'devpost' ? (
    <>
      <path d="M6 2h12l5 10-5 10H6L1 12 6 2Z" />
      <path d="M8 7h4a5 5 0 0 1 0 10H8V7Z" />
    </>
  ) : kind === 'resume' ? (
    <>
      <path d="M14 2H5v20h14V7l-5-5Z M14 2v5h5M8 11h8M8 15h8M8 18h5" />
    </>
  ) : ['email', 'contact'].includes(kind) ? (
    <>
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m2 6 10 7L22 6" />
    </>
  ) : kind === 'live' ? (
    <>
      <circle cx="12" cy="12" r="10" />
      <ellipse cx="12" cy="12" rx="4" ry="10" />
      <path d="M2 12h20" />
    </>
  ) : ['write-up', 'notes'].includes(kind) ? (
    <>
      <path d="M12 5c-3-2-7-2-10-1v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1ZM12 5v15" />
    </>
  ) : (
    <>
      <path d="M14 3h7v7M21 3l-9 9M10 3H3v18h18v-7" />
    </>
  )}
</svg>
<style>
  .link-icon { display: inline-block; flex: 0 0 auto; width: 1em; height: 1em; vertical-align: -0.15em; }
</style>
